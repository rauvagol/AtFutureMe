<local:OverlayWindowBase x:Class="AtFutureMe.Windows.ClockOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AtFutureMe.Windows"
        Title="@FutureMe Clock"
        MinWidth="200" MinHeight="220"
        Width="280" Height="300"
        MouseLeftButtonDown="OnWindowDrag">
    <Border x:Name="PanelBorder" CornerRadius="10" BorderBrush="#000000" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ChromeRow" Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="DitherLayer" Grid.RowSpan="2" CornerRadius="10" IsHitTestVisible="False"/>
            <Border x:Name="ChromeBar" Grid.Row="0" VerticalAlignment="Top" Padding="10,8,10,6"
                    CornerRadius="10,10,0,0" Background="Transparent" Tag="chrome">
                <DockPanel x:Name="Chrome">
                    <StackPanel x:Name="ChromeActions" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource ChromeButton}" Content="—" Click="OnHide"
                                ToolTip="Hide clock (re-enable from Configure → Clock)"/>
                    </StackPanel>
                    <TextBlock x:Name="ChromeTitle" Text="Next 24h" Style="{StaticResource OverlayCaption}"
                               Margin="6,0,8,0"/>
                </DockPanel>
            </Border>
            <Grid x:Name="FaceHost" Grid.Row="1" Margin="8,4,8,10" ClipToBounds="True">
                <Canvas x:Name="Face"/>
                <Canvas x:Name="Hands" IsHitTestVisible="False"/>
                <Canvas x:Name="Marks" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</local:OverlayWindowBase>
