<local:OverlayWindowBase x:Class="AtFutureMe.Windows.TempHideCountdown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AtFutureMe.Windows"
        Title=""
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        Focusable="False">
    <Border x:Name="PanelBorder" CornerRadius="10" BorderBrush="#000000" BorderThickness="1"
            ClipToBounds="True" IsHitTestVisible="False">
        <Grid>
            <Border x:Name="DitherLayer" CornerRadius="10" IsHitTestVisible="False"/>
            <StackPanel Margin="12,8,12,8" IsHitTestVisible="False">
                <TextBlock x:Name="RemainText" Text="1 minute" Style="{StaticResource OverlayCaption}"
                           HorizontalAlignment="Center" FontSize="18"/>
            </StackPanel>
        </Grid>
    </Border>
</local:OverlayWindowBase>
