<UserControl x:Class="AtFutureMe.Windows.OverlayItemRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseLeftButtonDown="OnDragDown"
             PreviewMouseMove="OnDragMove"
             PreviewMouseLeftButtonUp="OnDragUp">
    <Grid Margin="{Binding RowMargin}">
        <Border Opacity="{Binding AttentionGlow}"
                Background="#66FFD24D"
                CornerRadius="6"
                Margin="0,1"
                IsHitTestVisible="False"/>

        <Border Visibility="{Binding BackdropVisibility}"
                Background="{Binding BackdropBrush}"
                CornerRadius="6"
                Margin="0,1"
                IsHitTestVisible="False"/>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                  VerticalAlignment="Center">
                <CheckBox VerticalAlignment="Center" HorizontalAlignment="Left" Tag="hit"
                          Width="14" Height="14" Margin="0"
                          IsChecked="{Binding IsChecked, Mode=OneWay}"
                          IsEnabled="{Binding CheckEnabled}"
                          Click="OnCheck">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource OverlayCheck}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Margin" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCheck}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <Button Click="OnSetWhen"
                        Width="14" Height="14" Padding="0" Margin="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HitButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Height" Value="14"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" Width="14" Height="14">
                                            <Canvas Width="14" Height="14" SnapsToDevicePixels="True">
                                                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                                      Data="M0.6,3 H13.4 V13.4 H0.6 Z"/>
                                                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                                      Data="M4.3,0.6 V4.4 M9.7,0.6 V4.4"/>
                                                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                                      Data="M0.6,6.2 H13.4"/>
                                            </Canvas>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSetWhen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding Title}"
                       Foreground="{Binding Foreground}"
                       FontWeight="{Binding TitleWeight}"
                       TextDecorations="{Binding Decorations}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Tag="{Binding HitTag}"
                       MouseLeftButtonUp="OnTitleUp"
                       SnapsToDevicePixels="True"
                       TextOptions.TextFormattingMode="Display">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Cursor" Value="Arrow"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLink}" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0,0,0">
                <Button Click="OnDelay12" Margin="0,0,4,0">
                    <TextBlock Text="delay 12 hours" Margin="6,0"/>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HitButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowDelay12}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="↻" Click="OnCheckedNow">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HitButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCheckIn}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✕" Click="OnHide">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HitButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTrash}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✕" Click="OnDelete">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DeleteButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowDelete}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="3" Margin="2,0,0,0"
                       Text="{Binding Meta}"
                       Foreground="{Binding Foreground}"
                       FontWeight="{Binding TitleWeight}"
                       VerticalAlignment="Center"
                       SnapsToDevicePixels="True"
                       TextOptions.TextFormattingMode="Display">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCountdown}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{Binding Meta}"
                       Foreground="#9AA0A8"
                       FontWeight="{Binding TitleWeight}"
                       TextWrapping="Wrap"
                       FontSize="12" Margin="0,2,0,0"
                       SnapsToDevicePixels="True"
                       TextOptions.TextFormattingMode="Display">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBody}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
