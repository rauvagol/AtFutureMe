            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource DarkScrollViewer}">
                    <StackPanel Margin="4,8,12,8">
                        <Expander x:Name="SettingsOverlay" Style="{StaticResource SettingsExpander}"
                                  Header="Overlay" Tag="overlay"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                                <CheckBox x:Name="ClickThroughBox" Style="{StaticResource DarkCheck}"
                                          Content="Lock overlay — only checkboxes, ↻, and folder arrows receive clicks. Unlock to use the top bar, tasks, and folders; empty background still clicks through."
                                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SettingsTempHide" Style="{StaticResource SettingsExpander}"
                                  Header="Temporary hide" Tag="temphide"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                        <TextBlock Text="Unlocked top bar clock hides the main overlay. It comes back when the next important upcoming item is this close, or when the hide runs out — whichever is first. Due items in delayable folders don't count. If something important is already due, the clock is crossed out; hold it to highlight those items and their folders. A small click-through countdown appears in a corner before the overlay returns."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Show again this close to the next item" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <DockPanel>
                            <ComboBox x:Name="TempHideLeadUnitBox" DockPanel.Dock="Right" Width="110"
                                      Style="{StaticResource DarkCombo}"
                                      SelectionChanged="TempHideLeadUnitChanged">
                                <ComboBoxItem Content="Minutes"/>
                                <ComboBoxItem Content="Hours"/>
                            </ComboBox>
                            <TextBox x:Name="TempHideLeadBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                     LostFocus="TempHideLeadCommit" KeyDown="TempHideLeadKey"/>
                        </DockPanel>
                        <TextBlock Text="Hide lasts at most" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <DockPanel>
                            <ComboBox x:Name="TempHideMaxUnitBox" DockPanel.Dock="Right" Width="110"
                                      Style="{StaticResource DarkCombo}"
                                      SelectionChanged="TempHideMaxUnitChanged">
                                <ComboBoxItem Content="Minutes"/>
                                <ComboBoxItem Content="Hours"/>
                            </ComboBox>
                            <TextBox x:Name="TempHideMaxBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                     LostFocus="TempHideMaxCommit" KeyDown="TempHideMaxKey"/>
                        </DockPanel>
                        <TextBlock Text="Countdown appears this far before return" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <DockPanel>
                            <ComboBox x:Name="TempHideWarnUnitBox" DockPanel.Dock="Right" Width="110"
                                      Style="{StaticResource DarkCombo}"
                                      SelectionChanged="TempHideWarnUnitChanged">
                                <ComboBoxItem Content="Minutes"/>
                                <ComboBoxItem Content="Hours"/>
                            </ComboBox>
                            <TextBox x:Name="TempHideWarnBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                     LostFocus="TempHideWarnCommit" KeyDown="TempHideWarnKey"/>
                        </DockPanel>
                        <TextBlock Text="Countdown corner" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <ComboBox x:Name="TempHideCornerBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="TempHideCornerChanged">
                            <ComboBoxItem Content="Top left"/>
                            <ComboBoxItem Content="Top right"/>
                            <ComboBoxItem Content="Bottom left"/>
                            <ComboBoxItem Content="Bottom right"/>
                        </ComboBox>
                        <TextBlock Text="Clock" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <TextBlock x:Name="TempHideStatusText" Foreground="#C5C9D0" TextWrapping="Wrap"/>
                        <TextBlock Text="Next important upcoming" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <TextBlock x:Name="UpcomingScheduledList" Foreground="#C5C9D0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SettingsLook" Style="{StaticResource SettingsExpander}"
                                  Header="Appearance" Tag="look"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
