                        <CheckBox x:Name="WindowBorderBox" Style="{StaticResource DarkCheck}"
                                  Content="Window border"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>

                        <TextBlock Text="Panel opacity" Foreground="#9AA0A8" Margin="0,12,0,4"/>
