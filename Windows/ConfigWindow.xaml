                                  Content="Hide completed To Dos"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="HideCompletedRecurringBox" Style="{StaticResource DarkCheck}"
                                  Content="Hide completed Recurring"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="HideCompletedScheduledBox" Style="{StaticResource DarkCheck}"
                                  Content="Hide completed Scheduled"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Completed Recurring stay on the overlay with a countdown to the next reset unless you hide them. A folder can override this under Layout."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <CheckBox x:Name="HideEmptyFoldersBox" Style="{StaticResource DarkCheck}"
                                  Content="Hide folder if all contents are hidden"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="FolderCountsBox" Style="{StaticResource DarkCheck}"
                                  Content="Show uncompleted count on folders"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Counts items in the folder and nested folders. Completed tasks and hidden notes are not counted."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <CheckBox x:Name="ManualSortBox" Style="{StaticResource DarkCheck}"
                                  Content="Manual sort — overlay and Layout follow ↑↓"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Automatic sort: Recurring and Scheduled by due time, then To Dos, then notes, then folders. A pin on a task or folder (1 = first among siblings, 3 = third) holds that slot while everything else still sorts automatically. Layout ↑↓ sets a pin instead of turning on Manual sort. Manual sort freezes order to ↑↓ (including folders among tasks); pins still apply."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Top-level folders" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="TopFolderIndentLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="TopFolderIndentSlider" Minimum="0" Maximum="40" TickFrequency="1"
                                    SmallChange="1" LargeChange="4"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="TopFolderIndentChanged"/>
                        </DockPanel>
                        <TextBlock Text="How far root folders sit in from root-level tasks. 0 lines folder headers up with the task column."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Nested folders" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="IndentLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="IndentSlider" Minimum="0" Maximum="40" TickFrequency="1"
                                    SmallChange="1" LargeChange="4"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="IndentChanged"/>
                        </DockPanel>
                        <TextBlock Text="How far each nested folder steps in from its parent."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Tasks inside folders" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="ContentIndentLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="ContentIndentSlider" Minimum="0" Maximum="40" TickFrequency="1"
                                    SmallChange="1" LargeChange="4"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="ContentIndentChanged"/>
                        </DockPanel>
                        <TextBlock Text="Extra inset for tasks and notes under a folder. 0 lines their checkboxes up with root-level tasks (when top-level folder indent is also 0)."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <CheckBox x:Name="HorizonHoursBox" Style="{StaticResource DarkCheck}"
                                  Content="Count upcoming window in hours instead of days"
                                  Checked="HorizonUnitChanged" Unchecked="HorizonUnitChanged"/>
                        <TextBlock x:Name="RecurringHorizonCaption"
                                   Text="Only show Recurring within this many days (0 = all)"
                                   Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="RecurringHorizonLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="RecurringHorizonSlider" Minimum="0" Maximum="180" TickFrequency="1"
                                    SmallChange="1" LargeChange="7"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="RecurringHorizonChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="HorizonCaption"
                                   Text="Only show Scheduled within this many days (0 = all). A task can set its own window on Layout."
                                   Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="HorizonLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="HorizonSlider" Minimum="0" Maximum="180" TickFrequency="1"
                                    SmallChange="1" LargeChange="7"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="HorizonChanged"/>
                        </DockPanel>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SettingsSystem" Style="{StaticResource SettingsExpander}"
                                  Header="System" Tag="system"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                        <CheckBox x:Name="AutostartBox" Style="{StaticResource DarkCheck}"
                                  Content="Start with Windows (this user)"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="NotifyBox" Style="{StaticResource DarkCheck}"
                                  Content="Windows notifications when something becomes due (off by default)"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>

                        <TextBlock Text="Data file" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <TextBox x:Name="DataPath" Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource DarkButton}" Content="Open JSON" Click="OpenJson"/>
                            <Button Style="{StaticResource DarkButton}" Content="Open folder" Click="OpenFolder"/>
                            <Button Style="{StaticResource DarkButton}" Content="Create backup" Click="CreateBackup"/>
                        </StackPanel>
                        <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"/>

                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,20,0,0"
                                   Text="Minimize hides overlay windows to the notification area. Close (✕) quits the app. Unlock the overlay to drag, resize, use + to add entries, and the gear to configure. Drag items onto a folder to move them. Drag a folder onto another to nest it, onto the top or bottom of a header to reorder, or onto @FutureMe to make it top-level."/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Grid>
    </DockPanel>
</Window>
