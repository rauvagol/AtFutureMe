<Window x:Class="AtFutureMe.Windows.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AtFutureMe.Windows"
        Title="AtFutureMe — Configure"
        Style="{StaticResource DarkWindow}"
        Width="980" Height="680"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <DockPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="SettingsSearch" Style="{StaticResource DarkTextBox}" Padding="8,6"
                             TextChanged="SettingsSearchChanged"/>
                    <TextBlock x:Name="SettingsSearchHint" Text="Search settings" Foreground="#7A8088"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <ListBox x:Name="SettingsNav" Background="Transparent" BorderThickness="0"
                         Foreground="#E8EAED"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SettingsNavChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}" Margin="0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF2F323A"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2D34"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Group}" FontSize="11" Foreground="#8AB4F8" Margin="0,8,0,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowGroup}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" Foreground="#E8EAED"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <TabControl x:Name="MainTabs" Grid.Column="2" SelectionChanged="MainTabsChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="Layout">
                <Grid Margin="4,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9AA0A8" Margin="0,0,0,8"
                                   Text="The full overlay layout. Click a task or folder to edit it here."/>
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <Button Style="{StaticResource DarkButton}" Content="Add" Click="AddTask"/>
                                <Button Style="{StaticResource DarkButton}" Content="Add folder" Click="AddCategory"/>
                                <Button Style="{StaticResource DarkButton}" Content="Add inside" Click="AddSubcategory"/>
                            </WrapPanel>
                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkButton}" Content="↑"
                                    Click="MoveLayoutUp" Width="36" Padding="0,6" Margin="0" VerticalAlignment="Center"/>
                            <WrapPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                <Button Style="{StaticResource DarkButton}" Content="Duplicate" Click="DuplicateLayout"/>
                                <Button Style="{StaticResource DarkButton}" Content="Delete" Click="DeleteLayout"/>
                            </WrapPanel>
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkButton}" Content="↓"
                                    Click="MoveLayoutDown" Width="36" Padding="0,6" Margin="0" VerticalAlignment="Center"/>
                        </Grid>
                        <TreeView x:Name="LayoutTree" SelectedItemChanged="LayoutSelected"
                                  PreviewMouseLeftButtonDown="LayoutTreeMouseDown"
                                  PreviewMouseRightButtonDown="LayoutTreeRightDown"
                                  PreviewKeyDown="LayoutKeyDown">
                            <TreeView.ContextMenu>
                                <ContextMenu Style="{x:Null}">
                                    <MenuItem Header="Duplicate" Style="{x:Null}" Click="DuplicateLayout"/>
                                    <MenuItem Header="Move to…" Style="{x:Null}" Click="OpenMoveToFolder"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="True"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Foreground="#E8EAED" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Meta}" Foreground="#7A8088" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource ChromeButton}" Content="+" Width="22" Click="LayoutAddItem"/>
                                            <Button Style="{StaticResource ChromeFolderButton}" Width="22" Click="LayoutAddFolder"/>
                                        </StackPanel>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource DarkScrollViewer}">
                        <Grid>
                            <TextBlock x:Name="LayoutHint" TextWrapping="Wrap" Foreground="#9AA0A8"
                                       Text="Select a task or folder to edit it."/>
                            <Grid x:Name="LayoutEditorHost"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Tasks" Visibility="Collapsed">
                <Grid Margin="4,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Show" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TaskTypeBox" DockPanel.Dock="Top" Style="{StaticResource DarkCombo}"
                                  Margin="0,0,0,8" SelectionChanged="TaskFilterChanged"/>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Style="{StaticResource DarkButton}" Content="Add" Click="AddTask"/>
                            <Button Style="{StaticResource DarkButton}" Content="↑" Click="MoveTaskUp" Width="36" Padding="0,6"/>
                            <Button Style="{StaticResource DarkButton}" Content="↓" Click="MoveTaskDown" Width="36" Padding="0,6"/>
                            <Button Style="{StaticResource DarkButton}" Content="Delete" Click="DeleteTask"/>
                        </WrapPanel>
                        <ListBox x:Name="TaskList" Background="#FF2A2D34" Foreground="#E8EAED"
                                 BorderBrush="#FF3A3D45"
                                 SelectionChanged="TaskSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" Foreground="#E8EAED" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding TypeLabel}" Foreground="#7A8088" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource DarkScrollViewer}">
                        <Grid x:Name="TaskEditorHost">
                        <Grid x:Name="SharedTaskEditors">
                        <StackPanel x:Name="OnceEditor" IsEnabled="False" Visibility="Collapsed">
                            <TextBlock Text="Type" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBlock Text="To Do" Foreground="#C5C9D0" Margin="0,0,0,8"/>
                            <TextBlock Text="Title" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBox x:Name="OnceTitle" Style="{StaticResource DarkTextBox}" TextChanged="OnceFieldChanged"/>
                            <TextBlock Text="URL" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <TextBox x:Name="OnceUrl" Style="{StaticResource DarkTextBox}"
                                     TextChanged="OnceFieldChanged"/>
                            <WrapPanel x:Name="OnceUrlSteam" Margin="0,6,0,0" Visibility="Collapsed">
                                <Button Style="{StaticResource DarkButton}" Content="Run steam game" Tag="rungameid"
                                        Click="ConvertUrlToSteam"/>
                                <Button Style="{StaticResource DarkButton}" Content="Steam storefront" Tag="store"
                                        Click="ConvertUrlToSteam"/>
                                <Button Style="{StaticResource DarkButton}" Content="Steam news" Tag="appnews"
                                        Click="ConvertUrlToSteam"/>
                                <Button Style="{StaticResource DarkButton}" Content="Steam library" Tag="library"
                                        Click="ConvertUrlToSteam"/>
                            </WrapPanel>
                            <TextBlock Text="Focus window" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Clear"
                                        Margin="6,0,0,0" Click="ClearFocusWindow" Tag="once"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Pick…"
                                        Click="PickFocusWindow" Tag="once"/>
                                <TextBlock x:Name="OnceFocusLabel" Foreground="#C5C9D0" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Text="Automatic"/>
                            </DockPanel>
                            <TextBlock Text="Bring this window forward when the link is already open. Automatic uses the linked exe or Steam game."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="Folder" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <ComboBox x:Name="OnceCategory" Style="{StaticResource DarkCombo}"
                                      ItemTemplate="{StaticResource CategoryItemTemplate}" SelectionChanged="OnceFieldChanged"/>
                            <TextBlock Text="When checked" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <ComboBox x:Name="OnceCheckRuleBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="OnceCheckRuleChanged"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                       Text="Leave this on Use folder / Settings to follow the folder. Nested folders still apply when this is inherited."/>
                            <StackPanel x:Name="OnceReshowRow" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="Show again this long before reset" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <ComboBox x:Name="OnceReshowUnitBox" DockPanel.Dock="Right" Width="110"
                                              Style="{StaticResource DarkCombo}"
                                              SelectionChanged="OnceReshowUnitChanged">
                                        <ComboBoxItem Content="Days"/>
                                        <ComboBoxItem Content="Hours"/>
                                    </ComboBox>
                                    <TextBox x:Name="OnceReshowBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                             LostFocus="OnceReshowCommit" KeyDown="OnceReshowKey"/>
                                </DockPanel>
                            </StackPanel>
                            <CheckBox x:Name="OnceCompleted" Style="{StaticResource DarkCheck}"
                                      Content="Completed" Margin="0,12,0,0"
                                      Checked="OnceFieldChanged" Unchecked="OnceFieldChanged"/>
                            <TextBlock Text="Pin position" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <TextBox x:Name="OncePin" Style="{StaticResource DarkTextBox}"
                                     TextChanged="OnceFieldChanged"/>
                            <CheckBox x:Name="OnceHoldPin" Style="{StaticResource DarkCheck}"
                                      Content="Hold pin when hidden"
                                      Margin="0,8,0,0"
                                      Checked="OnceFieldChanged" Unchecked="OnceFieldChanged"/>
                            <TextBlock Text="0 follows automatic sort. 1 always first among siblings, 3 always third. Hold pin keeps that slot reserved when this item is hidden (for example completed), so later pins stay ahead of unpinned items."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Colors" Foreground="#8AB4F8" FontWeight="SemiBold" Margin="0,16,0,4"/>
                            <TextBlock Text="Leave a row empty or press Default to use Settings. Only states this To Do can show."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel x:Name="OnceColorHost"/>
                            <TextBlock Text="A checkbox on the overlay. Check it when you're done."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="TodoEditor" IsEnabled="False" Visibility="Collapsed">
                            <TextBlock Text="Type" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBlock Text="Recurring" Foreground="#C5C9D0" Margin="0,0,0,8"/>
                            <TextBlock Text="Title" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBox x:Name="TodoTitle" Style="{StaticResource DarkTextBox}" TextChanged="TodoFieldChanged"/>
                            <TextBlock Text="URL" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <TextBox x:Name="TodoUrl" Style="{StaticResource DarkTextBox}"
                                     TextChanged="TodoFieldChanged"/>
                            <WrapPanel x:Name="TodoUrlSteam" Margin="0,6,0,0" Visibility="Collapsed">
                                <Button Style="{StaticResource DarkButton}" Content="Run steam game" Tag="rungameid"
                                        Click="ConvertUrlToSteam"/>
                                <Button Style="{StaticResource DarkButton}" Content="Steam storefront" Tag="store"
                                        Click="ConvertUrlToSteam"/>
                                <Button Style="{StaticResource DarkButton}" Content="Steam news" Tag="appnews"
                                        Click="ConvertUrlToSteam"/>
                                <Button Style="{StaticResource DarkButton}" Content="Steam library" Tag="library"
                                        Click="ConvertUrlToSteam"/>
                            </WrapPanel>
                            <TextBlock Text="Focus window" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Clear"
                                        Margin="6,0,0,0" Click="ClearFocusWindow" Tag="todo"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Pick…"
                                        Click="PickFocusWindow" Tag="todo"/>
                                <TextBlock x:Name="TodoFocusLabel" Foreground="#C5C9D0" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Text="Automatic"/>
                            </DockPanel>
                            <TextBlock Text="Bring this window forward when the link is already open. Automatic uses the linked exe or Steam game."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="Folder" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <ComboBox x:Name="TodoCategory" Style="{StaticResource DarkCombo}"
                                      ItemTemplate="{StaticResource CategoryItemTemplate}" SelectionChanged="TodoFieldChanged"/>
                            <TextBlock Text="When checked" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <ComboBox x:Name="TodoCheckRuleBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="TodoCheckRuleChanged"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                       Text="Leave this on Use folder / Settings to follow the folder. Nested folders still apply when this is inherited."/>
                            <StackPanel x:Name="TodoReshowRow" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="Show again this long before reset" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <ComboBox x:Name="TodoReshowUnitBox" DockPanel.Dock="Right" Width="110"
                                              Style="{StaticResource DarkCombo}"
                                              SelectionChanged="TodoReshowUnitChanged">
                                        <ComboBoxItem Content="Days"/>
                                        <ComboBoxItem Content="Hours"/>
                                    </ComboBox>
                                    <TextBox x:Name="TodoReshowBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                             LostFocus="TodoReshowCommit" KeyDown="TodoReshowKey"/>
                                </DockPanel>
                            </StackPanel>

                            <CheckBox x:Name="TodoUnknownDate" Style="{StaticResource DarkCheck}"
                                      Content="Coming eventually — I don't know when"
                                      Checked="TodoWatchChanged" Unchecked="TodoWatchChanged"/>
                            <CheckBox x:Name="TodoEnabled" Style="{StaticResource DarkCheck}" Content="Enabled"
                                      Checked="TodoFieldChanged" Unchecked="TodoFieldChanged"/>
                            <!-- auto model -->
                            <CheckBox x:Name="TodoImportant" Style="{StaticResource DarkCheck}"
                                      Content="Important — force overlay out of temporary hide"
                                      Checked="TodoImportantChanged" Unchecked="TodoImportantChanged"/>
                            <StackPanel x:Name="TodoImportantLeadRow" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock Text="Show overlay this long before it is due" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <ComboBox x:Name="TodoImportantUnitBox" DockPanel.Dock="Right" Width="110"
                                              Style="{StaticResource DarkCombo}"
                                              SelectionChanged="TodoImportantUnitChanged">
                                        <ComboBoxItem Content="Days"/>
                                        <ComboBoxItem Content="Hours"/>
                                    </ComboBox>
                                    <TextBox x:Name="TodoImportantLeadBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                             LostFocus="TodoImportantLeadCommit" KeyDown="TodoImportantLeadKey"/>
                                </DockPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                           Text="While temporary hide is on, the overlay comes back for this window until the task is completed, then hide resumes."/>
                            </StackPanel>
                            <TextBlock Text="Pin position" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <TextBox x:Name="TodoPin" Style="{StaticResource DarkTextBox}"
                                     TextChanged="TodoFieldChanged"/>
                            <CheckBox x:Name="TodoHoldPin" Style="{StaticResource DarkCheck}"
                                      Content="Hold pin when hidden"
                                      Margin="0,8,0,0"
                                      Checked="TodoFieldChanged" Unchecked="TodoFieldChanged"/>
                            <TextBlock Text="0 follows automatic sort. 1 always first among siblings, 3 always third. Hold pin keeps that slot reserved when this item is hidden, so later pins stay ahead of unpinned items."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,6,0,0"/>

                            <StackPanel x:Name="TodoWatchFields" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock x:Name="TodoLastChecked" Foreground="#8AB4F8" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource DarkButton}" Content="I checked this now"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="MarkTodoCheckedNow"/>
                                <TextBlock Text="Check every" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TodoCheckAmount" Style="{StaticResource DarkTextBox}"
                                             TextChanged="TodoFieldChanged"/>
                                    <ComboBox x:Name="TodoCheckUnit" Grid.Column="2" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="TodoFieldChanged"/>
                                </Grid>
                                <TextBlock Text="Late colors move up each time this interval passes without a ↻ check. The checkbox still completes the item."
                                           Foreground="#7A8088" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="TodoScheduleFields">
                            <TextBlock Text="Repeats" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <ComboBox x:Name="TodoKind" Style="{StaticResource DarkCombo}" SelectionChanged="TodoKindChanged"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="TimeRow">
                                    <TextBlock Text="Time" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TodoTime" Style="{StaticResource DarkTextBox}"
                                             MaxLength="5"
                                             TextChanged="TodoFieldChanged"
                                             LostFocus="TodoTimeLostFocus"/>
                                </StackPanel>
                                <StackPanel x:Name="IntervalRow" Grid.Column="2">
                                    <TextBlock x:Name="IntervalLabel" Text="Every N" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TodoInterval" Style="{StaticResource DarkTextBox}" TextChanged="TodoFieldChanged"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="TodoDueByRow">
                            <TextBlock Text="Due by (optional)" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <TextBox x:Name="TodoDueByTime" Style="{StaticResource DarkTextBox}"
                                     MaxLength="5"
                                     TextChanged="TodoFieldChanged"
                                     LostFocus="TodoDueByTimeLostFocus"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                       Text="Leave empty for a single time. Set a later time (or earlier to wrap past midnight) so the clock shows a line at Time, a line at Due by, and a filled band between."/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock x:Name="TodoClockOpacityLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                           VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40" Text="100%"/>
                                <TextBlock Text="Clock opacity" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Slider x:Name="TodoClockOpacitySlider" Minimum="5" Maximum="100" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                    ValueChanged="TodoClockOpacityChanged"/>
                            </StackPanel>

                            <TextBlock x:Name="WeekdaysLabel" Text="Days" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <WrapPanel x:Name="WeekdaysPanel">
                                <CheckBox x:Name="DaySun" Style="{StaticResource DarkCheck}" Content="Sun" Click="TodoFieldChanged"/>
                                <CheckBox x:Name="DayMon" Style="{StaticResource DarkCheck}" Content="Mon" Click="TodoFieldChanged"/>
                                <CheckBox x:Name="DayTue" Style="{StaticResource DarkCheck}" Content="Tue" Click="TodoFieldChanged"/>
                                <CheckBox x:Name="DayWed" Style="{StaticResource DarkCheck}" Content="Wed" Click="TodoFieldChanged"/>
                                <CheckBox x:Name="DayThu" Style="{StaticResource DarkCheck}" Content="Thu" Click="TodoFieldChanged"/>
                                <CheckBox x:Name="DayFri" Style="{StaticResource DarkCheck}" Content="Fri" Click="TodoFieldChanged"/>
                                <CheckBox x:Name="DaySat" Style="{StaticResource DarkCheck}" Content="Sat" Click="TodoFieldChanged"/>
                            </WrapPanel>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="MonthDayRow">
                                    <TextBlock Text="Day of month" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TodoMonthDay" Style="{StaticResource DarkTextBox}" TextChanged="TodoFieldChanged"/>
                                </StackPanel>
                                <StackPanel x:Name="MonthRow" Grid.Column="2">
                                    <TextBlock Text="Month (1-12)" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TodoMonth" Style="{StaticResource DarkTextBox}" TextChanged="TodoFieldChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="NthRow">
                                    <TextBlock Text="Which (1-4, or -1 = last)" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TodoNth" Style="{StaticResource DarkTextBox}" TextChanged="TodoFieldChanged"/>
                                </StackPanel>
                                <StackPanel x:Name="WeekdayRow" Grid.Column="2">
                                    <TextBlock Text="Weekday (0=Sun … 6=Sat)" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="TodoWeekday" Style="{StaticResource DarkCombo}" SelectionChanged="TodoFieldChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TodoSummary" Foreground="#8AB4F8" Margin="0,16,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="Colors" Foreground="#8AB4F8" FontWeight="SemiBold" Margin="0,16,0,4"/>
                            <TextBlock Text="Leave a row empty or press Default to use Settings. Only states this Recurring item can show."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel x:Name="TodoColorHost"/>
                        </StackPanel>

                        <StackPanel x:Name="EventEditor" IsEnabled="False" Visibility="Collapsed">
                            <TextBlock Text="Type" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBlock Text="Scheduled" Foreground="#C5C9D0" Margin="0,0,0,8"/>
                            <TextBlock Text="Title" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBox x:Name="EventTitle" Style="{StaticResource DarkTextBox}" TextChanged="EventFieldChanged"/>
                            <TextBlock Text="URL" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <TextBox x:Name="EventUrl" Style="{StaticResource DarkTextBox}"
                                     TextChanged="EventFieldChanged"/>
                            <WrapPanel x:Name="EventUrlSteam" Margin="0,6,0,0" Visibility="Collapsed">
                                <Button Style="{StaticResource DarkButton}" Content="Run steam game" Tag="rungameid"
                                        Click="ConvertUrlToSteam"/>
                                <Button Style="{StaticResource DarkButton}" Content="Steam storefront" Tag="store"
                                        Click="ConvertUrlToSteam"/>
                                <Button Style="{StaticResource DarkButton}" Content="Steam news" Tag="appnews"
                                        Click="ConvertUrlToSteam"/>
                                <Button Style="{StaticResource DarkButton}" Content="Steam library" Tag="library"
                                        Click="ConvertUrlToSteam"/>
                            </WrapPanel>
                            <TextBlock Text="Focus window" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Clear"
                                        Margin="6,0,0,0" Click="ClearFocusWindow" Tag="event"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Pick…"
                                        Click="PickFocusWindow" Tag="event"/>
                                <TextBlock x:Name="EventFocusLabel" Foreground="#C5C9D0" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Text="Automatic"/>
                            </DockPanel>
                            <TextBlock Text="Bring this window forward when the link is already open. Automatic uses the linked exe or Steam game."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="Folder" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <ComboBox x:Name="EventCategory" Style="{StaticResource DarkCombo}"
                                      ItemTemplate="{StaticResource CategoryItemTemplate}" SelectionChanged="EventFieldChanged"/>
                            <TextBlock Text="When checked" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <ComboBox x:Name="EventCheckRuleBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="EventCheckRuleChanged"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                       Text="Leave this on Use folder / Settings to follow the folder. Nested folders still apply when this is inherited."/>
                            <StackPanel x:Name="EventReshowRow" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="Show again this long before reset" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <ComboBox x:Name="EventReshowUnitBox" DockPanel.Dock="Right" Width="110"
                                              Style="{StaticResource DarkCombo}"
                                              SelectionChanged="EventReshowUnitChanged">
                                        <ComboBoxItem Content="Days"/>
                                        <ComboBoxItem Content="Hours"/>
                                    </ComboBox>
                                    <TextBox x:Name="EventReshowBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                             LostFocus="EventReshowCommit" KeyDown="EventReshowKey"/>
                                </DockPanel>
                            </StackPanel>
                            <TextBlock Text="Pin position" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <TextBox x:Name="EventPin" Style="{StaticResource DarkTextBox}"
                                     TextChanged="EventFieldChanged"/>
                            <CheckBox x:Name="EventHoldPin" Style="{StaticResource DarkCheck}"
                                      Content="Hold pin when hidden"
                                      Margin="0,8,0,0"
                                      Checked="EventFieldChanged" Unchecked="EventFieldChanged"/>
                            <TextBlock Text="0 follows automatic sort. 1 always first among siblings, 3 always third. Hold pin keeps that slot reserved when this item is hidden, so later pins stay ahead of unpinned items."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <!-- auto model -->
                            <CheckBox x:Name="EventImportant" Style="{StaticResource DarkCheck}"
                                      Content="Important — force overlay out of temporary hide"
                                      Margin="0,12,0,0"
                                      Checked="EventImportantChanged" Unchecked="EventImportantChanged"/>
                            <StackPanel x:Name="EventImportantLeadRow" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock Text="Show overlay this long before it shows up" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <ComboBox x:Name="EventImportantUnitBox" DockPanel.Dock="Right" Width="110"
                                              Style="{StaticResource DarkCombo}"
                                              SelectionChanged="EventImportantUnitChanged">
                                        <ComboBoxItem Content="Days"/>
                                        <ComboBoxItem Content="Hours"/>
                                    </ComboBox>
                                    <TextBox x:Name="EventImportantLeadBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                             LostFocus="EventImportantLeadCommit" KeyDown="EventImportantLeadKey"/>
                                </DockPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                           Text="While temporary hide is on, the overlay comes back for this window until the task is completed, then hide resumes."/>
                            </StackPanel>
                            <CheckBox x:Name="EventUnknownDate" Style="{StaticResource DarkCheck}"
                                      Content="Coming eventually — I don't know when"
                                      Checked="EventUnknownChanged" Unchecked="EventUnknownChanged"/>
                            <StackPanel x:Name="EventWatchFields" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock x:Name="EventLastChecked" Foreground="#8AB4F8" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource DarkButton}" Content="I checked this now"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="MarkEventCheckedNow"/>
                                <TextBlock Text="Check every" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EventCheckAmount" Style="{StaticResource DarkTextBox}"
                                             TextChanged="EventFieldChanged"/>
                                    <ComboBox x:Name="EventCheckUnit" Grid.Column="2" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="EventFieldChanged"/>
                                </Grid>
                                <TextBlock Text="Late colors move up each time this interval passes without a ↻ check. When you know the date, set it from the overlay (or uncheck Coming eventually here). Checking to dismiss only works after that time."
                                           Foreground="#7A8088" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <TextBlock Text="Only show after this long since last check" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                                <DockPanel>
                                    <ComboBox x:Name="EventShowAfterUnitBox" DockPanel.Dock="Right" Width="110"
                                              Style="{StaticResource DarkCombo}"
                                              SelectionChanged="EventShowAfterUnitChanged">
                                        <ComboBoxItem Content="Days"/>
                                        <ComboBoxItem Content="Hours"/>
                                    </ComboBox>
                                    <TextBox x:Name="EventShowAfterBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                             LostFocus="EventShowAfterCommit" KeyDown="EventShowAfterKey"/>
                                </DockPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                           Text="0 keeps it on the overlay. After ↻ or a link click it stays hidden until this many days or hours pass."/>
                            </StackPanel>
                            <StackPanel x:Name="EventWhenFields">
                            <TextBlock Text="Date" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <DatePicker x:Name="EventDate" SelectedDateChanged="EventFieldChanged"/>
                            <TextBlock Text="Time (HH:mm)" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <TextBox x:Name="EventTime" Style="{StaticResource DarkTextBox}"
                                     MaxLength="5"
                                     TextChanged="EventFieldChanged"
                                     LostFocus="EventTimeLostFocus"/>
                            <TextBlock Text="Due by (optional)" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <DatePicker x:Name="EventDueByDate" SelectedDateChanged="EventFieldChanged"/>
                            <TextBox x:Name="EventDueByTime" Style="{StaticResource DarkTextBox}"
                                     MaxLength="5" Margin="0,8,0,0"
                                     TextChanged="EventFieldChanged"
                                     LostFocus="EventDueByTimeLostFocus"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                       Text="Leave blank for a single moment. With a due-by, the clock draws lines at start and end with a filled band between. Clears if the time box is empty."/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock x:Name="EventClockOpacityLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                           VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40" Text="100%"/>
                                <TextBlock Text="Clock opacity" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Slider x:Name="EventClockOpacitySlider" Minimum="5" Maximum="100" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                    ValueChanged="EventClockOpacityChanged"/>
                            <TextBlock Text="Scheduled countdown. Turns the due color when the date and time arrive (or when due-by passes). The overlay checkbox appears after the start, so you can dismiss it."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,16,0,0"/>
                            <TextBlock Text="Only show this long before it happens" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                            <DockPanel>
                                <ComboBox x:Name="EventShowBeforeUnitBox" DockPanel.Dock="Right" Width="110"
                                          Style="{StaticResource DarkCombo}"
                                          SelectionChanged="EventShowBeforeUnitChanged">
                                    <ComboBoxItem Content="Days"/>
                                    <ComboBoxItem Content="Hours"/>
                                </ComboBox>
                                <TextBox x:Name="EventShowBeforeBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                         LostFocus="EventShowBeforeCommit" KeyDown="EventShowBeforeKey"/>
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                       Text="0 uses Settings. Farther out than this, it stays off the overlay until the window opens."/>
                            </StackPanel>
                            <TextBlock Text="Colors" Foreground="#8AB4F8" FontWeight="SemiBold" Margin="0,16,0,4"/>
                            <TextBlock Text="Leave a row empty or press Default to use Settings. Only states this Scheduled item can show."
                                       Foreground="#7A8088" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel x:Name="EventColorHost"/>
                        </StackPanel>

                        <DockPanel x:Name="NoteEditor" IsEnabled="False" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <CheckBox x:Name="NoteHidden" Style="{StaticResource DarkCheck}" Content="Hidden from overlay"
                                          Checked="NoteFieldChanged" Unchecked="NoteFieldChanged"/>
                                <Button Style="{StaticResource DarkButton}" Content="Restore to overlay" HorizontalAlignment="Left"
                                        Click="RestoreNote" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Type" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <TextBlock Text="Note" Foreground="#C5C9D0" Margin="0,0,0,8"/>
                                <TextBlock Text="Title" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <TextBox x:Name="NoteTitle" Style="{StaticResource DarkTextBox}" TextChanged="NoteFieldChanged"/>
                                <TextBlock Text="URL" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                                <TextBox x:Name="NoteUrl" Style="{StaticResource DarkTextBox}"
                                         TextChanged="NoteFieldChanged"/>
                                <WrapPanel x:Name="NoteUrlSteam" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Button Style="{StaticResource DarkButton}" Content="Run steam game" Tag="rungameid"
                                            Click="ConvertUrlToSteam"/>
                                    <Button Style="{StaticResource DarkButton}" Content="Steam storefront" Tag="store"
                                            Click="ConvertUrlToSteam"/>
                                    <Button Style="{StaticResource DarkButton}" Content="Steam news" Tag="appnews"
                                            Click="ConvertUrlToSteam"/>
                                    <Button Style="{StaticResource DarkButton}" Content="Steam library" Tag="library"
                                            Click="ConvertUrlToSteam"/>
                                </WrapPanel>
                                <TextBlock Text="Focus window" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Clear"
                                            Margin="6,0,0,0" Click="ClearFocusWindow" Tag="note"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Pick…"
                                            Click="PickFocusWindow" Tag="note"/>
                                    <TextBlock x:Name="NoteFocusLabel" Foreground="#C5C9D0" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Text="Automatic"/>
                                </DockPanel>
                                <TextBlock Text="Bring this window forward when the link is already open. Automatic uses the linked exe or Steam game."
                                           Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="Folder" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                                <ComboBox x:Name="NoteCategory" Style="{StaticResource DarkCombo}"
                                          ItemTemplate="{StaticResource CategoryItemTemplate}" SelectionChanged="NoteFieldChanged"/>
                                <TextBlock Text="Pin position" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                                <TextBox x:Name="NotePin" Style="{StaticResource DarkTextBox}"
                                         TextChanged="NoteFieldChanged"/>
                                <CheckBox x:Name="NoteHoldPin" Style="{StaticResource DarkCheck}"
                                          Content="Hold pin when hidden"
                                          Margin="0,8,0,0"
                                          Checked="NoteFieldChanged" Unchecked="NoteFieldChanged"/>
                                <TextBlock Text="0 follows automatic sort. 1 always first among siblings, 3 always third. Hold pin keeps that slot reserved when this item is hidden, so later pins stay ahead of unpinned items."
                                           Foreground="#7A8088" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Body" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                                <TextBox x:Name="NoteBody" Style="{StaticResource DarkTextBox}" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="180"
                                         TextChanged="NoteFieldChanged"/>
                            </StackPanel>
                        </DockPanel>
                        </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Categories" Visibility="Collapsed">
                <Grid Margin="4,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Style="{StaticResource DarkButton}" Content="Add" Click="AddCategory"/>
                            <Button Style="{StaticResource DarkButton}" Content="Add inside" Click="AddSubcategory"/>
                            <Button Style="{StaticResource DarkButton}" Content="↑" Click="MoveCategoryUp" Width="36" Padding="0,6"/>
                            <Button Style="{StaticResource DarkButton}" Content="↓" Click="MoveCategoryDown" Width="36" Padding="0,6"/>
                            <Button Style="{StaticResource DarkButton}" Content="Delete" Click="DeleteCategory"/>
                        </WrapPanel>
                        <ListBox x:Name="CategoryList" Background="#FF2A2D34" Foreground="#E8EAED"
                                 BorderBrush="#FF3A3D45"
                                 SelectionChanged="CategorySelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TreeLabel}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource DarkScrollViewer}">
                    <Grid x:Name="CategoryEditorHost">
                    <StackPanel x:Name="CategoryEditor" IsEnabled="False">
                        <TextBlock Text="Name" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <TextBox x:Name="CategoryName" Style="{StaticResource DarkTextBox}" TextChanged="CategoryFieldChanged"/>
                        <TextBlock Text="Pin position" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <TextBox x:Name="CategoryPin" Style="{StaticResource DarkTextBox}" TextChanged="CategoryFieldChanged"/>
                        <CheckBox x:Name="CategoryHoldPin" Style="{StaticResource DarkCheck}"
                                  Content="Hold pin when hidden"
                                  Margin="0,8,0,0"
                                  Checked="CategoryFieldChanged" Unchecked="CategoryFieldChanged"/>
                        <TextBlock Text="1 = first among siblings (tasks and folders in the same place). 0 = unpinned — folders sit below tasks unless pinned. Hold pin keeps the slot when the folder is not shown."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Inside" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <ComboBox x:Name="CategoryParent" Style="{StaticResource DarkCombo}"
                                  ItemTemplate="{StaticResource CategoryItemTemplate}"
                                  SelectionChanged="CategoryFieldChanged"/>
                        <CheckBox x:Name="CategoryPopped" Style="{StaticResource DarkCheck}"
                                  Content="Pop out into its own window"
                                  Checked="CategoryFieldChanged" Unchecked="CategoryFieldChanged"/>
                        <CheckBox x:Name="CategoryDelayable" Style="{StaticResource DarkCheck}"
                                  Content="Delayable — due items here don't block temporary hide"
                                  Margin="0,8,0,0"
                                  Checked="CategoryFieldChanged" Unchecked="CategoryFieldChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                   Text="Treat this folder as not important for the clock button. Nested folders inherit this. You can still check items here as usual."/>
                        <TextBlock Text="When checked" Foreground="#9AA0A8" Margin="0,14,0,4"/>
                        <ComboBox x:Name="CategoryCheckRuleBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="CategoryCheckRuleChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                   Text="Nested folders inherit unless they set their own rule. A task can override this. Unfiled items follow Settings unless the task sets a rule. Delete-on-check can be undone from the overlay while this program stays open."/>
                        <StackPanel x:Name="CategoryReshowRow" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="Show again this long before reset" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <DockPanel>
                                <ComboBox x:Name="CategoryReshowUnitBox" DockPanel.Dock="Right" Width="110"
                                          Style="{StaticResource DarkCombo}"
                                          SelectionChanged="CategoryReshowUnitChanged">
                                    <ComboBoxItem Content="Days"/>
                                    <ComboBoxItem Content="Hours"/>
                                </ComboBox>
                                <TextBox x:Name="CategoryReshowBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                         LostFocus="CategoryReshowCommit" KeyDown="CategoryReshowKey"/>
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                       Text="Checked items stay hidden until this close to the next reset, then they come back on the overlay."/>
                        </StackPanel>
                        <TextBlock Text="Program pair" Foreground="#9AA0A8" Margin="0,14,0,4"/>
                        <TextBlock x:Name="CategoryPairLabel" TextWrapping="Wrap" Foreground="#C5C9D0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Style="{StaticResource DarkButton}" Content="Pair to a running program…"
                                    Click="PairCategoryProgram"/>
                            <Button Style="{StaticResource DarkButton}" Content="Clear pairing"
                                    Click="ClearCategoryPair"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,8,0,0"
                                   Text="Pops this folder while that program is running, even if another flagged app layout is active. Closing the program docks the folder only if this pairing opened it. For hide, lock, and window positions, flag the program on the Integration tab instead."/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,16,0,0"
                                   Text="Folders can hold to-dos, recurring and scheduled tasks, and notes together. They nest like directories. Add inside creates a folder inside the selected one. Up/down move among siblings. Deleting a folder moves its tasks and child folders up one level (or leaves tasks unfiled). Overlay arrows collapse like Explorer."/>
                    </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="CompletedTab" Header="Completed">
                <Grid Margin="4,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9AA0A8" Margin="0,0,0,8"
                                   Text="Tasks you've checked off. Change the completion date or time to backdate them."/>
                        <TextBlock DockPanel.Dock="Top" Text="Show" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CompletedTypeBox" DockPanel.Dock="Top" Style="{StaticResource DarkCombo}"
                                  Margin="0,0,0,8" SelectionChanged="CompletedFilterChanged"/>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource DarkButton}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Content="Delete" Click="CompletedDelete"/>
                        <ListBox x:Name="CompletedList" Background="#FF2A2D34" Foreground="#E8EAED"
                                 BorderBrush="#FF3A3D45"
                                 SelectionChanged="CompletedSelected"
                                 PreviewKeyDown="CompletedListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" Foreground="#E8EAED" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SubLabel}" Foreground="#7A8088" FontSize="11"/>
                                        <TextBlock Text="{Binding WhenLabel}" Foreground="#8AB4F8" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource DarkScrollViewer}">
                        <Grid>
                            <TextBlock x:Name="CompletedHint" TextWrapping="Wrap" Foreground="#9AA0A8"
                                       Text="No completed tasks yet. Check something off on the overlay, then it shows up here."/>
                            <StackPanel x:Name="CompletedEditor" IsEnabled="False" Visibility="Collapsed">
                                <TextBlock Text="Title" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <TextBlock x:Name="CompletedTitle" Foreground="#E8EAED" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="Type" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <TextBlock x:Name="CompletedType" Foreground="#C5C9D0" Margin="0,0,0,8"/>
                                <TextBlock Text="Folder" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                <TextBlock x:Name="CompletedFolder" Foreground="#C5C9D0" Margin="0,0,0,8"/>
                                <TextBlock Text="Completed date" Foreground="#9AA0A8" Margin="0,4,0,4"/>
                                <DatePicker x:Name="CompletedDate" SelectedDateChanged="CompletedWhenChanged"/>
                                <TextBlock Text="Completed time (HH:mm)" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                                <TextBox x:Name="CompletedTime" Style="{StaticResource DarkTextBox}"
                                         MaxLength="5"
                                         TextChanged="CompletedWhenChanged"
                                         LostFocus="CompletedTimeLostFocus"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource DarkButton}" Content="Set to now"
                                            Click="CompletedSetNow"/>
                                    <Button Style="{StaticResource DarkButton}" Content="Clear completion"
                                            Click="CompletedClear"/>
                                    <Button Style="{StaticResource DarkButton}" Content="Delete"
                                            Click="CompletedDelete"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,16,0,0"
                                           Text="To Dos and Scheduled stay done until you clear them. Recurring uses this time for the current cycle and for “after I complete it” schedules — backdating past the period start marks that cycle incomplete again."/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="IntegrationTab" Header="Integration">
                <ScrollViewer Margin="4,8,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource DarkScrollViewer}">
                    <StackPanel>
                        <TextBlock Text="Clock" Foreground="#E8EAED" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,0,0,8"
                                   Text="Enable the clock on the Clock tab. These keep it visible when the main overlay is put away."/>
                        <CheckBox x:Name="ClockStayWhenMainHiddenBox" Style="{StaticResource DarkCheck}"
                                  Content="Show when main overlay is hidden"
                                  Checked="IntegrationPopoutChanged" Unchecked="IntegrationPopoutChanged"/>
                        <CheckBox x:Name="ClockKeepOnTopBox" Style="{StaticResource DarkCheck}"
                                  Content="Keep above other windows"
                                  Margin="0,6,0,0"
                                  Checked="IntegrationPopoutChanged" Unchecked="IntegrationPopoutChanged"/>

                        <TextBlock x:Name="IntegrationDiscordHead" Text="Discord messages" Foreground="#E8EAED" Margin="0,24,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,0,0,8"
                                   Text="Reads your personal Discord inbox from the AtFutureMe Inbox Vencord plugin. Clock-face cues need the clock overlay on."/>
                        <CheckBox x:Name="DiscordModuleBox" Style="{StaticResource DarkCheck}"
                                  Content="Watch Discord inbox"
                                  Checked="IntegrationPopoutChanged" Unchecked="IntegrationPopoutChanged"/>
                        <CheckBox x:Name="DiscordInboxDebugBox" Style="{StaticResource DarkCheck}"
                                  Content="Debug missed alerts in a popout"
                                  Margin="0,8,0,0"
                                  Checked="DiscordInboxDebugChanged" Unchecked="DiscordInboxDebugChanged"/>
                        <TextBlock Text="Show alerts" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <ComboBox x:Name="DiscordDisplayBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="DiscordDisplayChanged">
                                <ComboBoxItem Content="Own window"/>
                                <ComboBoxItem Content="Clock face"/>
                                <ComboBoxItem Content="Window and clock"/>
                            </ComboBox>
                            <TextBlock Text="Clock cue" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <ComboBox x:Name="DiscordClockCueBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="DiscordClockCueChanged">
                                <ComboBoxItem Content="Pulse face"/>
                                <ComboBoxItem Content="Solid tint (like a due task)"/>
                                <ComboBoxItem Content="Pulse ring"/>
                                <ComboBoxItem Content="Dot on the rim"/>
                            </ComboBox>
                            <local:ColorRow x:Name="DiscordClockColorRow"/>
                            <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="DiscordClockOpacityLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Text="70%"/>
                            <TextBlock Text="Cue opacity" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Slider x:Name="DiscordClockOpacitySlider" Minimum="10" Maximum="100" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                    ValueChanged="DiscordClockOpacityChanged"/>
                            <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="DiscordClockRingInsetLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Text="8%"/>
                            <TextBlock Text="Pulse ring inward size" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Slider x:Name="DiscordClockRingInsetSlider" Minimum="0.04" Maximum="0.55" TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                    ValueChanged="DiscordClockRingInsetChanged"/>
                            <TextBlock Text="Sender on clock" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <ComboBox x:Name="DiscordClockSenderBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="DiscordClockSenderChanged">
                                <ComboBoxItem Content="Hidden"/>
                                <ComboBoxItem Content="On the face"/>
                                <ComboBoxItem Content="Below the clock"/>
                            </ComboBox>
                            <local:ColorRow x:Name="DiscordClockTextColorRow"/>
                            <CheckBox x:Name="DiscordClockNameOnlyBox" Style="{StaticResource DarkCheck}"
                                      Content="Name only — hide “New message from”"
                                      Margin="0,2,0,0"
                                      Checked="DiscordClockNameOnlyChanged" Unchecked="DiscordClockNameOnlyChanged"/>
                            <TextBlock Text="Plugin missing on clock" Foreground="#9AA0A8" Margin="0,14,0,4"/>
                            <ComboBox x:Name="DiscordMissingClockCueBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="DiscordMissingClockCueChanged">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="Pulse face"/>
                                <ComboBoxItem Content="Solid tint"/>
                                <ComboBoxItem Content="Pulse ring"/>
                                <ComboBoxItem Content="Dot on the rim"/>
                            </ComboBox>
                            <TextBlock Text="Missing text" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <ComboBox x:Name="DiscordMissingClockLabelBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="DiscordMissingClockLabelChanged">
                                <ComboBoxItem Content="Hidden"/>
                                <ComboBoxItem Content="On the face"/>
                                <ComboBoxItem Content="Below the clock"/>
                            </ComboBox>
                            <local:ColorRow x:Name="DiscordMissingClockColorRow"/>
                            <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="DiscordMissingClockOpacityLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Text="70%"/>
                            <TextBlock Text="Missing cue opacity" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Slider x:Name="DiscordMissingClockOpacitySlider" Minimum="10" Maximum="100" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                    ValueChanged="DiscordMissingClockOpacityChanged"/>
                            <TextBlock Text="Name aliases" Foreground="#9AA0A8" Margin="0,14,0,4"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,0,0,6"
                                       Text="Match a Discord username, display name, or user ID and show a shorter name instead."/>
                            <ListBox x:Name="DiscordAliasList" Background="#FF2A2D34" Foreground="#E8EAED"
                                     BorderBrush="#FF3A3D45" MinHeight="72" MaxHeight="140" Margin="0,0,0,8"
                                     PreviewMouseWheel="NestedListPreviewMouseWheel"
                                     SelectionChanged="DiscordAliasSelected"/>
                            <TextBlock Text="Discord name or ID" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBox x:Name="DiscordAliasFromBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>
                            <TextBlock Text="Show as" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBox x:Name="DiscordAliasToBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource DarkButton}" Content="Add / update" Click="DiscordAliasAdd"/>
                                <Button Style="{StaticResource DarkButton}" Content="Remove" Click="DiscordAliasRemove"/>
                            </WrapPanel>
                            <TextBlock Text="Name colors" Foreground="#9AA0A8" Margin="0,8,0,4"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,0,0,6"
                                       Text="Give specific people their own cue color, and optionally name text color, size, and outline."/>
                            <ListBox x:Name="DiscordNameColorList" Background="#FF2A2D34" Foreground="#E8EAED"
                                     BorderBrush="#FF3A3D45" MinHeight="56" MaxHeight="120" Margin="0,0,0,8"
                                     PreviewMouseWheel="NestedListPreviewMouseWheel"
                                     SelectionChanged="DiscordNameColorSelected"/>
                            <TextBlock Text="Name or ID" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBox x:Name="DiscordNameColorNameBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>
                            <local:ColorRow x:Name="DiscordNameColorRow"/>
                            <local:ColorRow x:Name="DiscordNameColorTextRow"/>
                            <CheckBox x:Name="DiscordNameColorTextSizeBox" Style="{StaticResource DarkCheck}"
                                      Content="Custom text size"
                                      Margin="0,0,0,4"
                                      Checked="DiscordNameColorTextSizeToggle" Unchecked="DiscordNameColorTextSizeToggle"/>
                            <StackPanel x:Name="DiscordNameColorTextSizeRow" Margin="0,0,0,8" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock x:Name="DiscordNameColorTextSizeLabel" DockPanel.Dock="Right"
                                               Foreground="#9AA0A8" VerticalAlignment="Center" Margin="8,0,0,0"
                                               MinWidth="36" Text="14"/>
                                    <TextBlock Text="Text size" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Slider x:Name="DiscordNameColorTextSizeSlider" Minimum="8" Maximum="48"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                        MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                        ValueChanged="DiscordNameColorTextSizeChanged"/>
                            </StackPanel>
                            <local:ColorRow x:Name="DiscordNameColorOutlineRow"/>
                            <StackPanel x:Name="DiscordNameColorOutlineStrengthRow" Margin="0,0,0,8" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock x:Name="DiscordNameColorOutlineStrengthLabel" DockPanel.Dock="Right"
                                               Foreground="#9AA0A8" VerticalAlignment="Center" Margin="8,0,0,0"
                                               MinWidth="24" Text="2"/>
                                    <TextBlock Text="Outline strength" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Slider x:Name="DiscordNameColorOutlineStrengthSlider" Minimum="1" Maximum="6"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                        MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                        ValueChanged="DiscordNameColorOutlineStrengthChanged"/>
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource DarkButton}" Content="Add / update" Click="DiscordNameColorAdd"/>
                                <Button Style="{StaticResource DarkButton}" Content="Remove" Click="DiscordNameColorRemove"/>
                            </WrapPanel>
                            <TextBlock Text="Priority names" Foreground="#9AA0A8" Margin="0,8,0,4"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,0,0,6"
                                       Text="When an unread DM arrives from one of these names (username, display name, alias, or user ID), play a sound."/>
                            <ListBox x:Name="DiscordPriorityList" Background="#FF2A2D34" Foreground="#E8EAED"
                                     BorderBrush="#FF3A3D45" MinHeight="56" MaxHeight="120" Margin="0,0,0,8"
                                     PreviewMouseWheel="NestedListPreviewMouseWheel"
                                     SelectionChanged="DiscordPrioritySelected"/>
                            <TextBlock Text="Name or ID" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <TextBox x:Name="DiscordPriorityNameBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource DarkButton}" Content="Add" Click="DiscordPriorityAdd"/>
                                <Button Style="{StaticResource DarkButton}" Content="Remove" Click="DiscordPriorityRemove"/>
                            </WrapPanel>
                            <TextBlock Text="Priority sound" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="DiscordPrioritySoundBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="DiscordPrioritySoundChanged"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="DiscordPriorityVolumeLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                           VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Text="70%"/>
                                <TextBlock Text="Volume" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Slider x:Name="DiscordPriorityVolumeSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                    ValueChanged="DiscordPriorityVolumeChanged"/>
                            <TextBlock Text="Repeat" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <ComboBox x:Name="DiscordPriorityRepeatBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="DiscordPriorityRepeatChanged">
                                <ComboBoxItem Content="Once per unread message"/>
                                <ComboBoxItem Content="Every X minutes while unread"/>
                                <ComboBoxItem Content="Every X minutes after Y minutes unread"/>
                            </ComboBox>
                            <StackPanel x:Name="DiscordPriorityIntervalRow" Margin="0,8,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock x:Name="DiscordPriorityIntervalLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="5 min"/>
                                    <TextBlock Text="Every (X)" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Slider x:Name="DiscordPriorityIntervalSlider" Minimum="1" Maximum="60" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                        MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                        ValueChanged="DiscordPriorityIntervalChanged"/>
                                <StackPanel x:Name="DiscordPriorityGraceRow" Margin="0,8,0,0" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock x:Name="DiscordPriorityGraceLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="10 min"/>
                                        <TextBlock Text="After unread (Y)" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Slider x:Name="DiscordPriorityGraceSlider" Minimum="1" Maximum="120" TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                            MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                            ValueChanged="DiscordPriorityGraceChanged"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource DarkButton}" Content="Test sound" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Click="DiscordPriorityTestSound"/>
                            <CheckBox x:Name="DiscordStayWhenMainHiddenBox" Style="{StaticResource DarkCheck}"
                                      Content="Show window when main overlay is hidden"
                                      Margin="0,12,0,0"
                                      Checked="IntegrationPopoutChanged" Unchecked="IntegrationPopoutChanged"/>
                            <CheckBox x:Name="DiscordKeepOnTopBox" Style="{StaticResource DarkCheck}"
                                      Content="Keep window above other windows"
                                      Margin="0,6,0,0"
                                      Checked="IntegrationPopoutChanged" Unchecked="IntegrationPopoutChanged"/>
                            <TextBlock Text="Window lock mode" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                            <ComboBox x:Name="DiscordLockModeBox" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="DiscordLockChanged">
                                <ComboBoxItem Content="Locked — click-through"/>
                                <ComboBoxItem Content="Semi-locked — drag to position"/>
                                <ComboBoxItem Content="Unlocked — chrome + resize"/>
                            </ComboBox>

                        <Grid x:Name="IntegrationApps" Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="App layouts" Foreground="#E8EAED" Margin="0,0,0,4"/>
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9AA0A8" Margin="0,0,0,8"
                                           Text="Flag a running program to give it its own overlay layout. Desktop is saved separately and comes back when none of these are running."/>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button Style="{StaticResource DarkButton}" Content="Flag program…" Click="AddAppLayout"/>
                                    <Button Style="{StaticResource DarkButton}" Content="Remove" Click="RemoveAppLayout"/>
                                </WrapPanel>
                                <ListBox x:Name="AppLayoutList" Background="#FF2A2D34" Foreground="#E8EAED"
                                         BorderBrush="#FF3A3D45" Height="200"
                                         PreviewMouseWheel="NestedListPreviewMouseWheel"
                                         SelectionChanged="AppLayoutSelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding ExeName}" Foreground="#E8EAED"/>
                                                <TextBlock Text="{Binding ExePath}" Foreground="#7A8088" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="AppLayoutHint" TextWrapping="Wrap" Foreground="#9AA0A8"
                                           Text="Select a flagged program, or flag one that is running now."/>
                                <StackPanel x:Name="AppLayoutEditor" IsEnabled="False">
                                    <TextBlock Text="While this program is running" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="AppLayoutHideBox" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="AppLayoutFieldChanged"/>
                                    <TextBlock Text="Clock while this program is running" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                                    <ComboBox x:Name="AppLayoutClockBox" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="AppLayoutFieldChanged"/>
                                    <CheckBox x:Name="AppLayoutLockBox" Style="{StaticResource DarkCheck}"
                                              Content="Lock overlay"
                                              Margin="0,12,0,0"
                                              Checked="AppLayoutFieldChanged" Unchecked="AppLayoutFieldChanged"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,16,0,0"
                                               Text="Flag first, then launch the program and arrange overlays. Moves, pop in/out, and folder collapse save to this program. Hide and lock are set here. Tray hide and lock are frozen while this layout is in control. Important tasks still force the main overlay visible when due or within their lead. Closing the last flagged program restores desktop. Folder pairs still pop their folder on top if that program is not a full layout."/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,28,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Folder pairing — running" Foreground="#E8EAED" Margin="0,0,0,4"/>
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9AA0A8" Margin="0,0,0,8"
                                           Text="Programs you can pair to a folder from Layout. Hide anything you will not pair."/>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button Style="{StaticResource DarkButton}" Content="Refresh" Click="RefreshPairTargets"/>
                                    <Button Style="{StaticResource DarkButton}" Content="Don't offer"
                                            Click="HidePairTarget"/>
                                </WrapPanel>
                                <ListBox x:Name="PairAvailableList" Background="#FF2A2D34" Foreground="#E8EAED"
                                         BorderBrush="#FF3A3D45" Height="200"
                                         PreviewMouseWheel="NestedListPreviewMouseWheel"
                                         ItemTemplate="{StaticResource PairExeTemplate}"
                                         MouseDoubleClick="HidePairTarget"/>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="Folder pairing — hidden" Foreground="#E8EAED" Margin="0,0,0,4"/>
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9AA0A8" Margin="0,0,0,8"
                                           Text="These stay off the pair picker. Double-click or Offer again to show them."/>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource DarkButton}" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Content="Offer again" Click="RestorePairTarget"/>
                                <ListBox x:Name="PairHiddenList" Background="#FF2A2D34" Foreground="#E8EAED"
                                         BorderBrush="#FF3A3D45" Height="200"
                                         PreviewMouseWheel="NestedListPreviewMouseWheel"
                                         ItemTemplate="{StaticResource PairExeTemplate}"
                                         MouseDoubleClick="RestorePairTarget"/>
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ClockTab" Header="Clock">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource DarkScrollViewer}" Margin="4,8,0,0">
                    <StackPanel MaxWidth="560">
                        <CheckBox x:Name="ClockModuleBox" Style="{StaticResource DarkCheck}"
                                  Content="Show clock module"
                                  Checked="ClockModuleChanged" Unchecked="ClockModuleChanged"/>
                        <TextBlock Text="Style, when no app layout is running" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <ComboBox x:Name="ClockStyleBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="ClockStyleChanged">
                            <ComboBoxItem Content="Full clock"/>
                            <ComboBoxItem Content="Lightweight — upcoming times only"/>
                        </ComboBox>
                        <TextBlock Text="Lightweight look-ahead" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <ComboBox x:Name="MiniClockHoursBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="MiniClockHoursChanged"/>
                        <TextBlock Text="Hide lightweight clock when empty" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <ComboBox x:Name="MiniClockHideBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="MiniClockHideChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                   Text="After the empty countdown, the lightweight clock stays hidden until a Discord alert or a task inside the look-ahead needs attention."/>

                        <Expander x:Name="ClockOptions" Style="{StaticResource SettingsExpander}"
                                  Header="Face" Tag="clock-options" IsExpanded="True" Margin="0,8,0,0"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                        <TextBlock Text="Lock mode" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <ComboBox x:Name="ClockLockModeBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="ClockLockChanged">
                            <ComboBoxItem Content="Locked — click-through, hover tips only"/>
                            <ComboBoxItem Content="Semi-locked — drag face to position (no resize)"/>
                            <ComboBoxItem Content="Unlocked — chrome + resize"/>
                        </ComboBox>
                        <CheckBox x:Name="ClockKeepFaceBox" Style="{StaticResource DarkCheck}"
                                  Content="Keep darkened face when locked / semi-locked"
                                  Margin="0,10,0,0"
                                  Checked="ClockFilterChanged" Unchecked="ClockFilterChanged"/>
                        <CheckBox x:Name="ClockSecondHandBox" Style="{StaticResource DarkCheck}"
                                  Content="Show second hand"
                                  Margin="0,8,0,0"
                                  Checked="ClockFilterChanged" Unchecked="ClockFilterChanged"/>
                        <CheckBox x:Name="ClockHourHandBox" Style="{StaticResource DarkCheck}"
                                  Content="Show hour hand (fixed, points straight up at Now)"
                                  Margin="0,8,0,0"
                                  Checked="ClockFilterChanged" Unchecked="ClockFilterChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,8,0,0"
                                   Text="Semi-lock and locked hide the title bar and top-align the face so you can place it at the edge of the screen. Semi-lock: drag the face to move. Second hand: :00 up, :15 right, :30 down, :45 left."/>

                        <TextBlock Text="Covers the next" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <ComboBox x:Name="ClockHorizonBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="ClockHorizonChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                   Text="Only spans that divide the 144 outer teeth, so one colored tooth marks each hour on the face."/>

                        <TextBlock Text="Time format" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <ComboBox x:Name="ClockHourFormatBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="ClockFilterChanged">
                            <ComboBoxItem Content="24-hour"/>
                            <ComboBoxItem Content="12-hour"/>
                        </ComboBox>

                        <DockPanel Margin="0,16,0,0">
                            <TextBlock x:Name="ClockTimePosLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Text="0%"/>
                            <TextBlock Text="Time position" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="ClockTimePosSlider" Minimum="0" Maximum="1" TickFrequency="0.01"
                                IsSnapToTickEnabled="False"
                                PreviewMouseLeftButtonDown="SliderGoToClick"
                                MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag"
                                LostMouseCapture="SliderEndDrag"
                                ValueChanged="ClockTimePosChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,4,0,0"
                                   Text="0% sits just under the Now mark; 100% moves the time toward the center."/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="ClockTimeFontSizeLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Text="13"/>
                            <TextBlock Text="Current time font size" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="ClockTimeFontSizeSlider" Minimum="8" Maximum="48" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="ClockTimeFontSizeChanged"/>

                        <TextBlock Text="Ticks" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <ComboBox x:Name="ClockTickStepBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="ClockFilterChanged">
                            <ComboBoxItem Content="Hours"/>
                            <ComboBoxItem Content="30 minutes"/>
                            <ComboBoxItem Content="15 minutes"/>
