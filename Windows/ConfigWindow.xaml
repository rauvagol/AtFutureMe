                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="ClockTickLengthChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="ClockSecondHandLenLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Text="78%"/>
                            <TextBlock Text="Second hand length" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="ClockSecondHandLenSlider" Minimum="0.01" Maximum="0.95" TickFrequency="0.01"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="ClockTickLengthChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="ClockHourHandLenLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Text="55%"/>
                            <TextBlock Text="Hour hand length" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="ClockHourHandLenSlider" Minimum="0.01" Maximum="0.95" TickFrequency="0.01"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="ClockTickLengthChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="ClockWedgeWidthLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
