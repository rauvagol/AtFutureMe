                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="ClockTickLengthChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,4,0,0"
                                   Text="Lengths snap to whole percents. Tick/second-hand % is of the ring radius; wedge width % is of the full circle."/>

                        <TextBlock Text="Face colors" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <local:ColorRow x:Name="ClockColorRingRow"/>
                        <local:ColorRow x:Name="ClockColorMajorTickRow"/>
                        <local:ColorRow x:Name="ClockColorMinorTickRow"/>
                        <local:ColorRow x:Name="ClockColorSecondHandRow"/>
                        <local:ColorRow x:Name="ClockColorHourHandRow"/>
                        <local:ColorRow x:Name="ClockColorTimeRow"/>
                        <CheckBox x:Name="ClockTimeOutlineBox" Style="{StaticResource DarkCheck}"
                                  Content="Outline current time"
                                  Margin="0,8,0,0"
                                  Checked="ClockFilterChanged" Unchecked="ClockFilterChanged"/>
                        <local:ColorRow x:Name="ClockColorTimeOutlineRow"/>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="ClockTimeOutlineStrengthLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Text="2"/>
                            <TextBlock Text="Time outline strength" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="ClockTimeOutlineStrengthSlider" Minimum="1" Maximum="6" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="ClockTimeOutlineStrengthChanged"/>
                        <local:ColorRow x:Name="ClockColorCaretRow"/>
                        <local:ColorRow x:Name="ClockColorFaceRow"/>

                        <TextBlock Text="Event colors" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <local:ColorRow x:Name="ClockColorRecurringRow"/>
                        <local:ColorRow x:Name="ClockColorScheduledRow"/>
                        <local:ColorRow x:Name="ClockColorDueRow"/>
                        <local:ColorRow x:Name="ClockColorWedgeLineRow"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,4,0,0"
                                   Text="Exact-time line is the opaque line through the middle of each task wedge."/>

                        <TextBlock Text="Show on the ring" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <CheckBox x:Name="ClockShowRecurringBox" Style="{StaticResource DarkCheck}"
                                  Content="Recurring"
                                  Checked="ClockFilterChanged" Unchecked="ClockFilterChanged"/>
                        <CheckBox x:Name="ClockShowScheduledBox" Style="{StaticResource DarkCheck}"
                                  Content="Scheduled"
                                  Margin="0,6,0,0"
                                  Checked="ClockFilterChanged" Unchecked="ClockFilterChanged"/>
                        <CheckBox x:Name="ClockShowLabelsBox" Style="{StaticResource DarkCheck}"
                                  Content="Also show event name labels (wedges + hover tip are enough for most cases)"
                                  Margin="0,6,0,0"
                                  Checked="ClockFilterChanged" Unchecked="ClockFilterChanged"/>

                        <CheckBox x:Name="ClockAllCategoriesBox" Style="{StaticResource DarkCheck}"
                                  Content="All folders"
                                  Margin="0,16,0,0"
                                  Checked="ClockAllCategoriesChanged" Unchecked="ClockAllCategoriesChanged"/>
                        <TextBlock Text="Folders" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <Border Background="#FF2A2D34" BorderBrush="#FF3A3D45" BorderThickness="1"
                                Padding="8" MaxHeight="220">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource DarkScrollViewer}">
                                <ItemsControl x:Name="ClockCategoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource DarkCheck}"
                                                      Content="{Binding Name}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Margin="0,2,0,2"
                                                      Checked="ClockCategoryPickChanged"
                                                      Unchecked="ClockCategoryPickChanged"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                   Text="Uncheck All folders to limit the ring to selected folders (nested items follow a selected parent). Unlock the clock above to move or resize it."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Usage">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource DarkScrollViewer}" Margin="4,8,0,0">
                    <StackPanel MaxWidth="560">
                        <CheckBox x:Name="UsageModuleBox" Style="{StaticResource DarkCheck}"
                                  Content="Show AI usage module"
                                  Checked="UsageModuleChanged" Unchecked="UsageModuleChanged"/>
                        <CheckBox x:Name="UsageDockInRemindersBox" Style="{StaticResource DarkCheck}"
                                  Content="Append under the task list (scroll to see it)"
                                  Margin="0,8,0,0"
                                  Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>
                        <CheckBox x:Name="UsageDockShowPercentBox" Style="{StaticResource DarkCheck}"
                                  Content="Docked rows: show used %"
                                  Margin="0,8,0,0"
                                  Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>
                        <CheckBox x:Name="UsageDockPlainGrayBox" Style="{StaticResource DarkCheck}"
                                  Content="Docked rows: plain gray % / time (not usage tint)"
                                  Margin="0,8,0,0"
                                  Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                   Text="Reads Claude Code and Cursor logins already on this PC. Sign in to Claude Code once (browser-only Claude is enough after that)."/>

                        <TextBlock Text="Lock mode" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <ComboBox x:Name="UsageLockModeBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="UsageLockChanged">
                            <ComboBoxItem Content="Locked — click-through"/>
                            <ComboBoxItem Content="Semi-locked — drag to position (no resize)"/>
                            <ComboBoxItem Content="Unlocked — chrome + resize"/>
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,4,0,0"
                                   Text="Lock mode applies to the floating usage window only."/>

                        <TextBlock Text="Providers" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <CheckBox x:Name="UsageShowClaudeBox" Style="{StaticResource DarkCheck}"
                                  Content="Claude (5-hour + weekly)"
                                  Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>
                        <CheckBox x:Name="UsageShowCursorBox" Style="{StaticResource DarkCheck}"
                                  Content="Cursor (plan remaining + billing cycle)"
                                  Margin="0,8,0,0"
                                  Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>

                        <DockPanel Margin="0,16,0,0">
                            <TextBlock x:Name="UsagePollLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="15m"/>
                            <TextBlock Text="Poll interval" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsagePollSlider" Minimum="5" Maximum="120" TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsagePollChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,4,0,0"
                                   Text="Claude’s usage endpoint rate-limits aggressively — prefer 15+ minutes."/>

                        <TextBlock Text="Reminders &amp; clock" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <CheckBox x:Name="UsageInjectRemindersBox" Style="{StaticResource DarkCheck}"
                                  Content="Show reset times on the reminders board"
                                  Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>
                        <CheckBox x:Name="UsageBoardSmartFilterBox" Style="{StaticResource DarkCheck}"
                                  Content="Only when at limit or capacity may go unused before reset"
                                  Margin="0,8,0,0"
                                  Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,4,0,0"
                                   Text="Example: 30% weekly left, one full 5h ≈ 10% of weekly, cushion 2× → alert when ≤30h remain until weekly reset."/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageSessionPctLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40" Text="10%"/>
                            <TextBlock Text="One full 5h ≈ % of weekly" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageSessionPctSlider" Minimum="1" Maximum="50" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageSmartKnobsChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageCushionLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40" Text="2×"/>
                            <TextBlock Text="Partial-session cushion" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageCushionSlider" Minimum="1" Maximum="5" TickFrequency="0.5"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageSmartKnobsChanged"/>

                        <TextBlock Text="At limit — show on board within" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,0,0,4"
                                   Text="When a meter is fully used, only list it on the reminders board this close to its reset."/>

                        <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="UsageLead5hLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="1h"/>
                            <TextBlock Text="Claude 5h" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageLead5hSlider" Minimum="0.25" Maximum="5" TickFrequency="0.25"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageLeadChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageLeadWeeklyLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="12h"/>
                            <TextBlock Text="Claude weekly" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageLeadWeeklySlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageLeadChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageLeadOpusLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="12h"/>
                            <TextBlock Text="Claude Opus weekly" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageLeadOpusSlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageLeadChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageLeadCursorLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="24h"/>
                            <TextBlock Text="Cursor billing" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageLeadCursorSlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageLeadChanged"/>

                        <CheckBox x:Name="UsageShowOnClockBox" Style="{StaticResource DarkCheck}"
                                  Content="Show reset wedges on the clock (green→red by used %)"
                                  Margin="0,16,0,0"
                                  Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>

                        <TextBlock Text="At limit — show on clock within" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,0,0,4"
                                   Text="Separate from the board. Fully used meters only get a clock wedge this close to reset (defaults are wider so the ring can still preview)."/>

                        <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="UsageClockLead5hLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="5h"/>
                            <TextBlock Text="Claude 5h" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageClockLead5hSlider" Minimum="0.25" Maximum="5" TickFrequency="0.25"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageClockLeadChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageClockLeadWeeklyLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="48h"/>
                            <TextBlock Text="Claude weekly" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageClockLeadWeeklySlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageClockLeadChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageClockLeadOpusLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="48h"/>
                            <TextBlock Text="Claude Opus weekly" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageClockLeadOpusSlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageClockLeadChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageClockLeadCursorLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="72h"/>
                            <TextBlock Text="Cursor billing" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageClockLeadCursorSlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageClockLeadChanged"/>

                        <TextBlock Text="Board row colors" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,0,0,6"
                                   Text="Per reset on the reminders list: usage tint (green→red), a fixed color, or the default idle task color."/>

                        <TextBlock Text="Claude 5h" Foreground="#9AA0A8" Margin="0,4,0,4"/>
                        <ComboBox x:Name="UsageBoardColorMode5hBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="UsageBoardColorModeChanged">
                            <ComboBoxItem Content="Usage tint (green→red)"/>
                            <ComboBoxItem Content="Fixed color"/>
                            <ComboBoxItem Content="Default (no special color)"/>
                        </ComboBox>
                        <local:ColorRow x:Name="UsageBoardColor5hRow"/>

                        <TextBlock Text="Claude weekly" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <ComboBox x:Name="UsageBoardColorModeWeeklyBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="UsageBoardColorModeChanged">
                            <ComboBoxItem Content="Usage tint (green→red)"/>
                            <ComboBoxItem Content="Fixed color"/>
                            <ComboBoxItem Content="Default (no special color)"/>
                        </ComboBox>
                        <local:ColorRow x:Name="UsageBoardColorWeeklyRow"/>

                        <TextBlock Text="Claude Opus weekly" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <ComboBox x:Name="UsageBoardColorModeOpusBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="UsageBoardColorModeChanged">
                            <ComboBoxItem Content="Usage tint (green→red)"/>
                            <ComboBoxItem Content="Fixed color"/>
                            <ComboBoxItem Content="Default (no special color)"/>
                        </ComboBox>
                        <local:ColorRow x:Name="UsageBoardColorOpusRow"/>

                        <TextBlock Text="Cursor billing" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <ComboBox x:Name="UsageBoardColorModeCursorBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="UsageBoardColorModeChanged">
                            <ComboBoxItem Content="Usage tint (green→red)"/>
                            <ComboBoxItem Content="Fixed color"/>
                            <ComboBoxItem Content="Default (no special color)"/>
                        </ComboBox>
                        <local:ColorRow x:Name="UsageBoardColorCursorRow"/>

                        <TextBlock Text="Accent colors" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <local:ColorRow x:Name="UsageColorClaudeRow"/>
                        <local:ColorRow x:Name="UsageColorCursorRow"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"
                                   Text="Clock wedges still tint green→red from remaining usage; accents are for the usage overlay headers."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource DarkScrollViewer}">
                    <StackPanel Margin="4,8,12,8">
                        <Expander x:Name="SettingsOverlay" Style="{StaticResource SettingsExpander}"
                                  Header="Overlay" Tag="overlay"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                                <CheckBox x:Name="ClickThroughBox" Style="{StaticResource DarkCheck}"
                                          Content="Lock overlay — only checkboxes, ↻, and folder arrows receive clicks. Unlock to use the top bar, tasks, and folders; empty background still clicks through."
                                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SettingsTempHide" Style="{StaticResource SettingsExpander}"
                                  Header="Temporary hide" Tag="temphide"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                        <TextBlock Text="Unlocked top bar clock hides the main overlay. It comes back when the next important upcoming item is this close, or when the hide runs out — whichever is first. Due items in delayable folders don't count. If something important is already due, the clock is crossed out; hold it to highlight those items and their folders. A small click-through countdown appears in a corner before the overlay returns."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Show again this close to the next item" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <DockPanel>
                            <ComboBox x:Name="TempHideLeadUnitBox" DockPanel.Dock="Right" Width="110"
                                      Style="{StaticResource DarkCombo}"
                                      SelectionChanged="TempHideLeadUnitChanged">
                                <ComboBoxItem Content="Minutes"/>
                                <ComboBoxItem Content="Hours"/>
                            </ComboBox>
                            <TextBox x:Name="TempHideLeadBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                     LostFocus="TempHideLeadCommit" KeyDown="TempHideLeadKey"/>
                        </DockPanel>
                        <TextBlock Text="Hide lasts at most" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <DockPanel>
                            <ComboBox x:Name="TempHideMaxUnitBox" DockPanel.Dock="Right" Width="110"
                                      Style="{StaticResource DarkCombo}"
                                      SelectionChanged="TempHideMaxUnitChanged">
                                <ComboBoxItem Content="Minutes"/>
                                <ComboBoxItem Content="Hours"/>
                            </ComboBox>
                            <TextBox x:Name="TempHideMaxBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                     LostFocus="TempHideMaxCommit" KeyDown="TempHideMaxKey"/>
                        </DockPanel>
                        <TextBlock Text="Countdown appears this far before return" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <DockPanel>
                            <ComboBox x:Name="TempHideWarnUnitBox" DockPanel.Dock="Right" Width="110"
                                      Style="{StaticResource DarkCombo}"
                                      SelectionChanged="TempHideWarnUnitChanged">
                                <ComboBoxItem Content="Minutes"/>
                                <ComboBoxItem Content="Hours"/>
                            </ComboBox>
                            <TextBox x:Name="TempHideWarnBox" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                     LostFocus="TempHideWarnCommit" KeyDown="TempHideWarnKey"/>
                        </DockPanel>
                        <TextBlock Text="Countdown corner" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <ComboBox x:Name="TempHideCornerBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="TempHideCornerChanged">
                            <ComboBoxItem Content="Top left"/>
                            <ComboBoxItem Content="Top right"/>
                            <ComboBoxItem Content="Bottom left"/>
                            <ComboBoxItem Content="Bottom right"/>
                        </ComboBox>
                        <TextBlock Text="Clock" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <TextBlock x:Name="TempHideStatusText" Foreground="#C5C9D0" TextWrapping="Wrap"/>
                        <TextBlock Text="Next important upcoming" Foreground="#9AA0A8" Margin="0,10,0,4"/>
                        <TextBlock x:Name="UpcomingScheduledList" Foreground="#C5C9D0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SettingsLook" Style="{StaticResource SettingsExpander}"
                                  Header="Appearance" Tag="look"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                        <CheckBox x:Name="WindowBorderBox" Style="{StaticResource DarkCheck}"
                                  Content="Window border"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>

                        <TextBlock Text="Panel opacity" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="0.95"
                                    SmallChange="0.01" LargeChange="0.05"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="False"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="OpacityChanged"/>
                        </DockPanel>

                        <TextBlock Text="Panel darkness" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="DarknessLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="DarknessSlider" Minimum="0" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.05"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="False"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="DarknessChanged"/>
                        </DockPanel>

                        <CheckBox x:Name="PanelDitherBox" Style="{StaticResource DarkCheck}"
                                  Content="Black dither — faint grain so desktop detail doesn't read through"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Dither amount" Foreground="#9AA0A8" Margin="0,8,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="DitherLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="DitherSlider" Minimum="0" Maximum="0.75"
                                    SmallChange="0.01" LargeChange="0.05"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="False"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="DitherChanged"/>
                        </DockPanel>

                        <CheckBox x:Name="TextBackdropBox" Style="{StaticResource DarkCheck}"
                                  Content="Text backdrop — solid chip behind each item"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Text backdrop opacity" Foreground="#9AA0A8" Margin="0,8,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="BackdropLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="BackdropSlider" Minimum="0.2" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.05"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="False"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="BackdropChanged"/>
                        </DockPanel>

                        <TextBlock Text="Font size" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="FontLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="FontSlider" Minimum="10" Maximum="22" TickFrequency="1"
                                    SmallChange="1" LargeChange="2"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="FontChanged"/>
                        </DockPanel>
                        <CheckBox x:Name="BoldTextBox" Style="{StaticResource DarkCheck}"
                                  Content="Bold overlay text"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SettingsColors" Style="{StaticResource SettingsExpander}"
                                  Header="Task colors" Tag="colors"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                        <TextBlock Text="Defaults for overlay text. Each task on Layout can override the states that apply to it."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <local:ColorRow x:Name="ColorTodoRow"/>
                        <local:ColorRow x:Name="ColorRecurringRow"/>
                        <local:ColorRow x:Name="ColorScheduledRow"/>
                        <local:ColorRow x:Name="ColorDueRow"/>
                        <local:ColorRow x:Name="ColorLate1Row"/>
                        <local:ColorRow x:Name="ColorLate2Row"/>
                        <local:ColorRow x:Name="ColorLate3Row"/>
                        <local:ColorRow x:Name="ColorCompletedRow"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SettingsList" Style="{StaticResource SettingsExpander}"
                                  Header="List" Tag="list"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                        <CheckBox x:Name="HideCompletedOnceBox" Style="{StaticResource DarkCheck}"
                                  Content="Hide completed To Dos"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="HideCompletedRecurringBox" Style="{StaticResource DarkCheck}"
                                  Content="Hide completed Recurring"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="HideCompletedScheduledBox" Style="{StaticResource DarkCheck}"
                                  Content="Hide completed Scheduled"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Completed Recurring stay on the overlay with a countdown to the next reset unless you hide them. A folder can override this under Layout."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <CheckBox x:Name="HideEmptyFoldersBox" Style="{StaticResource DarkCheck}"
                                  Content="Hide folder if all contents are hidden"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="FolderCountsBox" Style="{StaticResource DarkCheck}"
                                  Content="Show uncompleted count on folders"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Counts items in the folder and nested folders. Completed tasks and hidden notes are not counted."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <CheckBox x:Name="ManualSortBox" Style="{StaticResource DarkCheck}"
                                  Content="Manual sort — overlay and Layout follow ↑↓"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Automatic sort: Recurring and Scheduled by due time, then To Dos, then notes, then folders. A pin on a task or folder (1 = first among siblings, 3 = third) holds that slot while everything else still sorts automatically. Layout ↑↓ sets a pin instead of turning on Manual sort. Manual sort freezes order to ↑↓ (including folders among tasks); pins still apply."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Top-level folders" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="TopFolderIndentLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="TopFolderIndentSlider" Minimum="0" Maximum="40" TickFrequency="1"
                                    SmallChange="1" LargeChange="4"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="TopFolderIndentChanged"/>
                        </DockPanel>
                        <TextBlock Text="How far root folders sit in from root-level tasks. 0 lines folder headers up with the task column."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Nested folders" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="IndentLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="IndentSlider" Minimum="0" Maximum="40" TickFrequency="1"
                                    SmallChange="1" LargeChange="4"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="IndentChanged"/>
                        </DockPanel>
                        <TextBlock Text="How far each nested folder steps in from its parent."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Tasks inside folders" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="ContentIndentLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="ContentIndentSlider" Minimum="0" Maximum="40" TickFrequency="1"
                                    SmallChange="1" LargeChange="4"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="ContentIndentChanged"/>
                        </DockPanel>
                        <TextBlock Text="Extra inset for tasks and notes under a folder. 0 lines their checkboxes up with root-level tasks (when top-level folder indent is also 0)."
                                   Foreground="#7A8088" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <CheckBox x:Name="HorizonHoursBox" Style="{StaticResource DarkCheck}"
                                  Content="Count upcoming window in hours instead of days"
                                  Checked="HorizonUnitChanged" Unchecked="HorizonUnitChanged"/>
                        <TextBlock x:Name="RecurringHorizonCaption"
                                   Text="Only show Recurring within this many days (0 = all)"
                                   Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="RecurringHorizonLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="RecurringHorizonSlider" Minimum="0" Maximum="180" TickFrequency="1"
                                    SmallChange="1" LargeChange="7"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="RecurringHorizonChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="HorizonCaption"
                                   Text="Only show Scheduled within this many days (0 = all). A task can set its own window on Layout."
                                   Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="HorizonLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="HorizonSlider" Minimum="0" Maximum="180" TickFrequency="1"
                                    SmallChange="1" LargeChange="7"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="HorizonChanged"/>
                        </DockPanel>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SettingsSystem" Style="{StaticResource SettingsExpander}"
                                  Header="System" Tag="system"
                                  Expanded="SettingsSectionChanged" Collapsed="SettingsSectionChanged">
                            <StackPanel>
                        <CheckBox x:Name="AutostartBox" Style="{StaticResource DarkCheck}"
                                  Content="Start with Windows (this user)"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="NotifyBox" Style="{StaticResource DarkCheck}"
                                  Content="Windows notifications when something becomes due (off by default)"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>

                        <TextBlock Text="Data file" Foreground="#9AA0A8" Margin="0,16,0,4"/>
                        <TextBox x:Name="DataPath" Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource DarkButton}" Content="Open JSON" Click="OpenJson"/>
                            <Button Style="{StaticResource DarkButton}" Content="Open folder" Click="OpenFolder"/>
                            <Button Style="{StaticResource DarkButton}" Content="Create backup" Click="CreateBackup"/>
                        </StackPanel>
                        <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" Foreground="#7A8088" Margin="0,6,0,0"/>

                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,20,0,0"
                                   Text="Minimize hides overlay windows to the notification area. Close (✕) quits the app. Unlock the overlay to drag, resize, use + to add entries, and the gear to configure. Drag items onto a folder to move them. Drag a folder onto another to nest it, onto the top or bottom of a header to reorder, or onto @FutureMe to make it top-level."/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
