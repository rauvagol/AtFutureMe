                                    MouseMove="SliderDrag"
                                    MouseLeftButtonUp="SliderEndDrag"
                                    LostMouseCapture="SliderEndDrag"
                                    ValueChanged="OpacityChanged"/>
                        </DockPanel>

                        <TextBlock Text="Panel darkness" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <DockPanel>
                            <TextBlock x:Name="DarknessLabel" DockPanel.Dock="Right" Width="48" Foreground="#C5C9D0"/>
                            <Slider x:Name="DarknessSlider" Minimum="0" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.05"
                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="False"
                                    PreviewMouseLeftButtonDown="SliderGoToClick"
                                    MouseMove="SliderDrag"
