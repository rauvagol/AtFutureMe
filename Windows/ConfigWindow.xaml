                                  SelectionChanged="UsageBoardColorModeChanged">
                            <ComboBoxItem Content="Usage tint (green→red)"/>
                            <ComboBoxItem Content="Fixed color"/>
                            <ComboBoxItem Content="Default (no special color)"/>
                        </ComboBox>
                        <local:ColorRow x:Name="UsageBoardColor5hRow"/>

                        <TextBlock Text="Claude weekly" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <ComboBox x:Name="UsageBoardColorModeWeeklyBox" Style="{StaticResource DarkCombo}"
                                  SelectionChanged="UsageBoardColorModeChanged">
                            <ComboBoxItem Content="Usage tint (green→red)"/>
                            <ComboBoxItem Content="Fixed color"/>
                            <ComboBoxItem Content="Default (no special color)"/>
                        </ComboBox>
                        <local:ColorRow x:Name="UsageBoardColorWeeklyRow"/>

                        <TextBlock Text="Claude Opus weekly" Foreground="#9AA0A8" Margin="0,12,0,4"/>
