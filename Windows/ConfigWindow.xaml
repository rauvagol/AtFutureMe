                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="48h"/>
                            <TextBlock Text="Claude weekly" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageClockLeadWeeklySlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageClockLeadChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageClockLeadOpusLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="48h"/>
                            <TextBlock Text="Claude Opus weekly" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageClockLeadOpusSlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageClockLeadChanged"/>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="UsageClockLeadCursorLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="72h"/>
                            <TextBlock Text="Cursor billing" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageClockLeadCursorSlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
