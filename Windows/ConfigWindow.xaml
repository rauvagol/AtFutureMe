                            <TextBlock x:Name="UsageLeadCursorLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="24h"/>
                            <TextBlock Text="Cursor billing" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageLeadCursorSlider" Minimum="1" Maximum="168" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                PreviewMouseLeftButtonDown="SliderGoToClick" MouseMove="SliderDrag"
                                MouseLeftButtonUp="SliderEndDrag" LostMouseCapture="SliderEndDrag"
                                ValueChanged="UsageLeadChanged"/>

                        <CheckBox x:Name="UsageShowOnClockBox" Style="{StaticResource DarkCheck}"
                                  Content="Show reset wedges on the clock (green→red by used %)"
                                  Margin="0,16,0,0"
                                  Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>

                        <TextBlock Text="At limit — show on clock within" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8088" Margin="0,0,0,4"
                                   Text="Separate from the board. Fully used meters only get a clock wedge this close to reset (defaults are wider so the ring can still preview)."/>

                        <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="UsageClockLead5hLabel" DockPanel.Dock="Right" Foreground="#9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" Text="5h"/>
                            <TextBlock Text="Claude 5h" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="UsageClockLead5hSlider" Minimum="0.25" Maximum="5" TickFrequency="0.25"
