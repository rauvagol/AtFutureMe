<local:OverlayWindowBase x:Class="AtFutureMe.Windows.DiscordOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AtFutureMe.Windows"
        Title="@FutureMe Discord"
        MinWidth="200" MinHeight="160"
        Width="280" Height="280"
        MouseLeftButtonDown="OnWindowDrag">
    <Border x:Name="PanelBorder" CornerRadius="10" BorderBrush="#000000" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ChromeRow" Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="DitherLayer" Grid.RowSpan="2" CornerRadius="10" IsHitTestVisible="False"/>
            <Border x:Name="ChromeBar" Grid.Row="0" VerticalAlignment="Top" Padding="10,8,10,6"
                    CornerRadius="10,10,0,0" Background="Transparent" Tag="chrome">
                <DockPanel x:Name="Chrome">
                    <StackPanel x:Name="ChromeActions" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource ChromeButton}" Content="—" Click="OnHide"/>
                    </StackPanel>
                    <TextBlock x:Name="ChromeTitle" Text="Discord" Style="{StaticResource OverlayCaption}"
                               Margin="6,0,8,0"/>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="BodyHost" Grid.Row="1" Margin="10,6,10,10"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource DarkScrollViewer}">
                <StackPanel x:Name="Alerts"/>
            </ScrollViewer>
        </Grid>
    </Border>
</local:OverlayWindowBase>
