<Window x:Class="AtFutureMe.Windows.MoveToFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move to Folder"
        Width="380" Height="440"
        MinWidth="300" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#FFF0F0F0"
        Foreground="#FF000000"
        FontFamily="Segoe UI"
        FontSize="12"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Topmost="True"
        PreviewKeyDown="OnWindowPreviewKey">
    <DockPanel Margin="11">
        <TextBlock DockPanel.Dock="Top" Text="Look in:" Margin="0,0,0,4"/>
        <TextBox x:Name="PathBox" DockPanel.Dock="Top" Style="{x:Null}" IsReadOnly="True"
                 Margin="0,0,0,8" Padding="6,4"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="MoveButton" Style="{x:Null}" Content="Move" Width="88" Height="26"
                        Margin="0,0,8,0" Click="OnMove"/>
                <Button Style="{x:Null}" Content="Cancel" Width="88" Height="26"
                        IsCancel="True" Click="OnCancel"/>
            </StackPanel>
            <Button Style="{x:Null}" Content="Add folder" Width="88" Height="26"
                    HorizontalAlignment="Left" Click="OnAddFolder"/>
        </DockPanel>
        <StackPanel x:Name="NewFolderBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="Folder name" Margin="0,0,0,4"/>
            <DockPanel>
                <Button x:Name="CreateFolderButton" DockPanel.Dock="Right" Style="{x:Null}"
                        Content="Create" Width="88" Height="26" Margin="8,0,0,0" Click="OnCreateFolder"/>
                <Button x:Name="CreateAndMoveButton" DockPanel.Dock="Right" Style="{x:Null}"
                        Content="Create + Move" MinWidth="110" Height="26" Padding="10,0"
                        Click="OnCreateAndMove"/>
                <TextBox x:Name="NewFolderName" Style="{x:Null}" Padding="6,4" Margin="0,0,8,0"/>
            </DockPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="#FF5A5A5A" TextWrapping="Wrap"
                   Text="Double-click a folder to open it. Add folder creates one in Look in. Create + Move makes the folder and sends the items there. Move uses the selected folder, or Look in if none is selected."/>
        <Border Background="White" BorderBrush="#FFADADAD" BorderThickness="1">
            <ListBox x:Name="FolderList" Style="{x:Null}" ItemContainerStyle="{x:Null}" BorderThickness="0"
                     KeyboardNavigation.AcceptsReturn="True"
                     MouseDoubleClick="OnActivate"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}"
                                       Width="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="#FFD83B01"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
