<local:OverlayWindowBase x:Class="AtFutureMe.Windows.RemindersOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AtFutureMe.Windows"
        Title="@FutureMe"
        MinWidth="220" MinHeight="120"
        AllowDrop="True"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop"
        MouseLeftButtonDown="OnWindowDrag">
    <Border x:Name="PanelBorder" CornerRadius="10" BorderBrush="#000000" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ChromeRow" Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="DitherLayer" Grid.RowSpan="2" CornerRadius="10" IsHitTestVisible="False"/>
            <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Margin="10,0,10,8"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource DarkScrollViewer}">
                <StackPanel>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource OverlayTitle}"
                               Text="Right-click the notification icon to unlock, then use + to add an item or the folder icon to add a folder."
                               TextWrapping="Wrap" Foreground="#7A8088"/>
                    <ItemsControl x:Name="LooseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:OverlayItemRow/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="CategoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:CategorySectionBlock/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="ChromeBar" Grid.Row="0" VerticalAlignment="Top" Padding="10,8,10,6"
                    CornerRadius="10,10,0,0" Background="Transparent" Tag="chrome">
                <DockPanel x:Name="Chrome">
                    <StackPanel x:Name="ChromeActions" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="GearButton" Style="{StaticResource ChromeButton}"
                                FontFamily="Segoe MDL2 Assets" FontSize="12" Content="&#xE713;"
                                Click="OnOpenConfig" ToolTip="Configure"/>
                        <Button Style="{StaticResource ChromeButton}" Content="+" Click="OnAdd" ToolTip="Add an item"/>
                        <Button Style="{StaticResource ChromeFolderButton}" Click="OnAddFolder"
                                ToolTip="Add a folder"/>
                        <Button x:Name="UndoButton" Style="{StaticResource ChromeButton}"
                                FontFamily="Segoe MDL2 Assets" FontSize="12" Content="&#xE7A7;"
                                Click="OnUndoDelete" ToolTip="Undo delete"/>
                        <Button x:Name="SnoozeButton" Style="{StaticResource ChromeButton}"
                                PreviewMouseLeftButtonDown="OnTempHideDown"
                                PreviewMouseLeftButtonUp="OnTempHideUp"
                                LostMouseCapture="OnTempHideLostCapture"
                                Click="OnTempHide">
                            <TextBlock x:Name="SnoozeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Text="&#xE708;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Content="—" Click="OnMinimize" ToolTip="Hide this window"/>
                        <Button Style="{StaticResource ChromeButton}" Content="✕" Click="OnClose" ToolTip="Quit AtFutureMe"/>
                    </StackPanel>
                    <TextBlock x:Name="ChromeTitle" Text="@FutureMe" Style="{StaticResource OverlayCaption}"
                               Margin="6,0,8,0"
                               AllowDrop="True" Tag="drop"
                               DragOver="OnRootDragOver" Drop="OnRootDrop"
                               ToolTip="Drop a folder here to move it to the top level"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</local:OverlayWindowBase>
