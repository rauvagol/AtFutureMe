<local:OverlayWindowBase x:Class="AtFutureMe.Windows.MiniClockOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AtFutureMe.Windows"
        Title="@FutureMe"
        MinWidth="180" MinHeight="80"
        Width="280" Height="220"
        SizeToContent="Height"
        MouseLeftButtonDown="OnWindowDrag">
    <Border x:Name="PanelBorder" CornerRadius="10" BorderBrush="#000000" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ChromeRow" Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="DitherLayer" Grid.RowSpan="2" CornerRadius="10" IsHitTestVisible="False"/>
            <Border x:Name="ChromeBar" Grid.Row="0" VerticalAlignment="Top" Padding="10,8,10,6"
                    CornerRadius="10,10,0,0" Background="Transparent" Tag="chrome">
                <DockPanel>
                    <StackPanel x:Name="ChromeActions" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource ChromeButton}" Content="—" Click="OnHide"/>
                    </StackPanel>
                    <TextBlock x:Name="ChromeTitle" Text="Upcoming" Style="{StaticResource OverlayCaption}"
                               Margin="6,0,8,0"/>
                </DockPanel>
            </Border>
            <StackPanel x:Name="BodyHost" Grid.Row="1" Margin="12,4,12,12"/>
        </Grid>
    </Border>
</local:OverlayWindowBase>
