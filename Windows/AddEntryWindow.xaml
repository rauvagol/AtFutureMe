<Window x:Class="AtFutureMe.Windows.AddEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add entry"
        Style="{StaticResource DarkWindow}"
        Width="440" Height="560"
        MinWidth="360" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource DarkButton}" Content="Cancel" IsCancel="True" Click="OnCancel"/>
            <Button Style="{StaticResource DarkButton}" Content="Add" IsDefault="True" Click="OnAdd"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewer}">
        <StackPanel>
            <StackPanel x:Name="TypeRow">
                <TextBlock Text="Type" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                <ComboBox x:Name="TypeBox" Style="{StaticResource DarkCombo}" SelectionChanged="TypeChanged"/>
            </StackPanel>
            <TextBlock x:Name="CategoryLabel" Text="Folder" Foreground="#9AA0A8" Margin="0,12,0,4"/>
            <ComboBox x:Name="CategoryBox" Style="{StaticResource DarkCombo}"
                      ItemTemplate="{StaticResource CategoryItemTemplate}"/>
            <TextBlock x:Name="TitleLabel" Text="Title" Foreground="#9AA0A8" Margin="0,12,0,4"/>
            <TextBox x:Name="TitleBox" Style="{StaticResource DarkTextBox}"/>

            <StackPanel x:Name="TodoFields" Visibility="Collapsed">
                <TextBlock Text="Repeats" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                <ComboBox x:Name="RepeatBox" Style="{StaticResource DarkCombo}" SelectionChanged="RepeatChanged"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TimeRow">
                        <TextBlock Text="Time" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <TextBox x:Name="RepeatTime" Style="{StaticResource DarkTextBox}"
                                 MaxLength="5"
                                 Text="00:00"
                                 TextChanged="RepeatChanged"
                                 LostFocus="RepeatTimeLostFocus"/>
                    </StackPanel>
                    <StackPanel x:Name="IntervalRow" Grid.Column="2">
                        <TextBlock x:Name="IntervalLabel" Text="Every N" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <TextBox x:Name="RepeatInterval" Style="{StaticResource DarkTextBox}" Text="1"
                                 TextChanged="RepeatChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="WeekdaysLabel" Text="Days" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                <WrapPanel x:Name="WeekdaysPanel">
                    <CheckBox x:Name="DaySun" Style="{StaticResource DarkCheck}" Content="Sun" Click="RepeatChanged"/>
                    <CheckBox x:Name="DayMon" Style="{StaticResource DarkCheck}" Content="Mon" Click="RepeatChanged"/>
                    <CheckBox x:Name="DayTue" Style="{StaticResource DarkCheck}" Content="Tue" Click="RepeatChanged"/>
                    <CheckBox x:Name="DayWed" Style="{StaticResource DarkCheck}" Content="Wed" Click="RepeatChanged"/>
                    <CheckBox x:Name="DayThu" Style="{StaticResource DarkCheck}" Content="Thu" Click="RepeatChanged"/>
                    <CheckBox x:Name="DayFri" Style="{StaticResource DarkCheck}" Content="Fri" Click="RepeatChanged"/>
                    <CheckBox x:Name="DaySat" Style="{StaticResource DarkCheck}" Content="Sat" Click="RepeatChanged"/>
                </WrapPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="MonthDayRow">
                        <TextBlock Text="Day of month" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <TextBox x:Name="RepeatMonthDay" Style="{StaticResource DarkTextBox}" Text="1"
                                 TextChanged="RepeatChanged"/>
                    </StackPanel>
                    <StackPanel x:Name="MonthRow" Grid.Column="2">
                        <TextBlock Text="Month (1-12)" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <TextBox x:Name="RepeatMonth" Style="{StaticResource DarkTextBox}" Text="1"
                                 TextChanged="RepeatChanged"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="NthRow">
                        <TextBlock Text="Which (1-4, or -1 = last)" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <TextBox x:Name="RepeatNth" Style="{StaticResource DarkTextBox}" Text="1"
                                 TextChanged="RepeatChanged"/>
                    </StackPanel>
                    <StackPanel x:Name="WeekdayRow" Grid.Column="2">
                        <TextBlock Text="Weekday" Foreground="#9AA0A8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="RepeatWeekday" Style="{StaticResource DarkCombo}" SelectionChanged="RepeatChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="RepeatSummary" Foreground="#8AB4F8" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <CheckBox x:Name="UnknownDateBox" Style="{StaticResource DarkCheck}"
                      Content="Coming eventually — I don't know when"
                      Visibility="Collapsed"
                      Checked="UnknownDateChanged" Unchecked="UnknownDateChanged"/>

            <StackPanel x:Name="CheckEveryFields" Visibility="Collapsed">
                <TextBlock Text="Check every" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CheckEveryAmount" Style="{StaticResource DarkTextBox}" Text="1"/>
                    <ComboBox x:Name="CheckEveryUnit" Grid.Column="2" Style="{StaticResource DarkCombo}"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="EventFields" Visibility="Collapsed">
                <TextBlock Text="Date" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                <DatePicker x:Name="EventDate"/>
                <TextBlock Text="Time (HH:mm)" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                <TextBox x:Name="EventTime" Style="{StaticResource DarkTextBox}"
                         MaxLength="5"
                         Text="09:00"
                         TextChanged="EventTimeChanged"
                         LostFocus="EventTimeLostFocus"/>
            </StackPanel>

            <StackPanel x:Name="NoteFields" Visibility="Collapsed">
                <TextBlock Text="Body" Foreground="#9AA0A8" Margin="0,12,0,4"/>
                <TextBox x:Name="NoteBody" Style="{StaticResource DarkTextBox}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <TextBlock x:Name="TodoHint" Foreground="#7A8088" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
