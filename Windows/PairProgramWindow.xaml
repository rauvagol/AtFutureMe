<Window x:Class="AtFutureMe.Windows.PairProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair to a running program"
        Style="{StaticResource DarkWindow}"
        Width="520" Height="480"
        MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="True">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource DarkButton}" Content="Refresh" Click="OnRefresh"/>
                <Button Style="{StaticResource DarkButton}" Content="Cancel" IsCancel="True" Click="OnCancel"/>
                <Button Style="{StaticResource DarkButton}" Content="Pair" IsDefault="True" Click="OnPair"/>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="HintText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9AA0A8" Margin="0,0,0,10"
                   Text="Pick a running program. Hide anything you will not pair so it stays out of this list. When that program is running, this folder pops out on top of the desktop (or an app layout). When it exits, the folder goes back."/>
        <ListBox x:Name="ExeList" Background="#FF2A2D34" Foreground="#E8EAED"
                 BorderBrush="#FF3A3D45" MouseDoubleClick="OnPair">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Margin="8,0,0,0"
                                Padding="8,4" VerticalAlignment="Center"
                                Content="Don't offer" Click="OnHide" Tag="{Binding}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="#E8EAED"/>
                            <TextBlock Text="{Binding FilePath}" Foreground="#7A8088" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
