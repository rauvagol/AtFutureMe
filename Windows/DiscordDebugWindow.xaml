<Window x:Class="AtFutureMe.Windows.DiscordDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord inbox debug"
        Style="{StaticResource DarkWindow}"
        Width="560" Height="640"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9AA0A8" Margin="0,0,0,10"
                   Text="Live. Turn this off or close the window when you’re done — no restart."/>
        <TextBox x:Name="LogBox" Style="{StaticResource DarkTextBox}"
                 AcceptsReturn="True" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontSize="12"/>
    </DockPanel>
</Window>
